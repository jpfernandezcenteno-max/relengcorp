---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

// Logos reales de clientes (en /public/images/clientes).
// Medida estándar: todos comparten la misma altura máxima (--client-logo-h en el CSS)
// y max-width 100%. Los logos altos/cuadrados se topan a esa altura y los muy anchos
// los limita el ancho del contenedor, de modo que todos se ven de tamaño parecido.
const clientSlugs = [
  'altonorte', 'antamina', 'antapaccay', 'bechtel', 'capstone', 'chinalco', 'codelco',
  'grupo-mexico-southern', 'hudbay', 'las-bambas', 'lomas-bayas', 'marcobre', 'minera-ares',
  'newmont', 'nexa', 'nirsa', 'ocp-cobriza', 'panamerican', 'pelambres', 'teck', 'tintaya', 'volcan',
];
const nameFor = (s: string) => ({
  'grupo-mexico-southern': 'Grupo México Southern',
  'ocp-cobriza': 'OCP Cobriza',
  'minera-ares': 'Minera Ares',
  'las-bambas': 'Las Bambas',
  'lomas-bayas': 'Lomas Bayas',
}[s] ?? s.charAt(0).toUpperCase() + s.slice(1));
const clients = clientSlugs.map((s) => ({ name: nameFor(s), logo: `/images/clientes/${s}.png` }));

// Se muestran de a 8 (4 columnas x 2 filas) y rotan en loop.
const perSlide = 8;
const slides: (typeof clients)[] = [];
for (let i = 0; i < clients.length; i += perSlide) slides.push(clients.slice(i, i + perSlide));

const sectors = [
  'Minería de cobre', 'Minería de oro', 'Plantas concentradoras',
  'Transporte de relaves', 'Energía', 'Industria pesada',
];
---
<BaseLayout
  title="Clientes y Experiencia"
  description="Experiencia de Relengcorp en operaciones críticas de minería, industria e ingeniería en Perú, Chile y otros proyectos de Latinoamérica."
>
  <PageHeader
    eyebrow="EXPERIENCIA Y CONFIANZA"
    title="Confianza construida en operaciones exigentes"
    subtitle="Relaciones construidas en terreno, proyecto a proyecto. Trabajamos con compañías mineras, industriales y de ingeniería en desafíos de mantenimiento, integridad, confiabilidad, operación y transformación tecnológica, desarrollando relaciones basadas en rigor técnico, seguridad y cumplimiento."
    imageLabel="Operación industrial cliente"
    image="13.webp"
  />

  <section class="section">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow eyebrow--center">Algunos de nuestros clientes</p>
        <h2 class="h-l">Marcas que confían en nosotros</h2>
      </div>

      <div class="clients-carousel" data-clients-carousel data-reveal>
        {slides.map((slide, si) => (
          <ul class:list={['clients-grid', 'clients-slide', { 'is-active': si === 0 }]} data-slide={si}>
            {slide.map((c) => (
              <li class="client-logo"><img src={c.logo} alt={c.name} loading="lazy" decoding="async" /></li>
            ))}
          </ul>
        ))}
      </div>

      {slides.length > 1 && (
        <div class="clients-dots" aria-label="Grupos de clientes">
          {slides.map((_, si) => (
            <button type="button" class:list={['clients-dot', { 'is-active': si === 0 }]} data-dot={si} aria-label={`Ver grupo ${si + 1} de ${slides.length}`}></button>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section section-subtle sectors">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow eyebrow--center">Sectores que atendemos</p>
        <h2 class="h-l">Experiencia transversal a la industria</h2>
      </div>
      <div class="sectors-grid">
        {sectors.map((s) => (
          <div class="sector-chip" data-reveal>{s}</div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Carrusel: los grupos se apilan en la misma celda y hacen crossfade */
  .clients-carousel { display: grid; }
  .clients-slide {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s var(--ease-out), visibility 0.6s var(--ease-out);
  }
  .clients-slide.is-active { opacity: 1; visibility: visible; }

  .clients-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-6); }
  .client-logo {
    display: grid; place-items: center;
    height: 92px; padding: var(--space-3) var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: box-shadow var(--dur-base) var(--ease-out);
  }
  .client-logo:hover { box-shadow: var(--shadow-3); }
  .client-logo img {
    max-width: 100%; max-height: 46px;
    width: auto; height: auto; object-fit: contain;
    filter: grayscale(1); opacity: 0.8;
    transition: filter var(--dur-base) var(--ease-out), opacity var(--dur-base) var(--ease-out);
  }
  .client-logo:hover img { filter: grayscale(0); opacity: 1; }

  .clients-dots { display: flex; justify-content: center; gap: var(--space-3); margin-top: var(--space-8); }
  .clients-dot {
    width: 10px; height: 10px; padding: 0;
    border: none; border-radius: 50%;
    background: var(--border); cursor: pointer;
    transition: background var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }
  .clients-dot:hover { background: var(--neutro-300); }
  .clients-dot.is-active { background: var(--accent); transform: scale(1.25); }

  /* Sin animación: se muestran todos los grupos apilados */
  .clients-carousel.is-static { display: flex; flex-direction: column; gap: var(--space-6); }
  .clients-carousel.is-static .clients-slide { grid-area: auto; opacity: 1; visibility: visible; }

  .sectors { background: var(--bg-subtle); }
  .sectors-grid {
    display: flex; flex-wrap: nowrap; gap: var(--space-3);
    width: max-content; max-width: 100%; margin-inline: auto;
    overflow-x: auto; scrollbar-width: none;
  }
  .sectors-grid::-webkit-scrollbar { display: none; }
  .sector-chip {
    flex: 0 0 auto; white-space: nowrap;
    padding: var(--space-3) var(--space-5);
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-pill); font-weight: var(--fw-semibold); color: var(--text-strong);
  }

  @media (max-width: 900px) { .clients-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 560px) { .clients-grid { grid-template-columns: repeat(2, 1fr); } }
</style>

<script>
  const carousel = document.querySelector<HTMLElement>('[data-clients-carousel]');
  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.clients-slide'));
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.clients-dot'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (slides.length > 1 && !reduce) {
      let idx = 0;
      let timer: number | undefined;

      const show = (i: number) => {
        idx = (i + slides.length) % slides.length;
        slides.forEach((s, n) => s.classList.toggle('is-active', n === idx));
        dots.forEach((d, n) => d.classList.toggle('is-active', n === idx));
      };
      const start = () => { timer = window.setInterval(() => show(idx + 1), 4500); };
      const stop = () => { if (timer) window.clearInterval(timer); };

      dots.forEach((d, n) => d.addEventListener('click', () => { show(n); stop(); start(); }));
      carousel.addEventListener('mouseenter', stop);
      carousel.addEventListener('mouseleave', start);
      start();
    } else if (reduce) {
      carousel.classList.add('is-static');
    }
  }
</script>
