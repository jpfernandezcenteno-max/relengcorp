---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import ParticlesField from '../../components/ParticlesField.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const [featured, ...rest] = posts;
const sidePosts = rest.slice(0, 2);
const morePosts = rest.slice(2);
---
<BaseLayout
  title="Conocimiento Aplicado"
  description="Artículos técnicos y experiencias sobre integridad, mantenimiento predictivo, confiabilidad, metalurgia, sensorización, ingeniería digital y reparables."
>
  <!-- Encabezado del blog -->
  <header class="blog-hero">
    <ParticlesField selector=".blog-hero" />
    <div class="container blog-hero__inner">
      <p class="blog-hero__eyebrow" data-reveal>CONOCIMIENTO APLICADO</p>
      <h1 class="blog-hero__title h-xl" data-reveal>Ingeniería, confiabilidad y operaciones críticas</h1>
      <p class="blog-hero__sub text-l" data-reveal>
        Compartimos experiencias, criterios técnicos y desarrollos aplicados para comprender mejor los activos, anticipar riesgos y mejorar decisiones de operación y mantenimiento.
      </p>
      <form class="blog-hero__capture" data-subscribe data-reveal novalidate>
        <input
          type="email"
          name="email"
          class="blog-hero__capture-input"
          placeholder="Ingresa tu email"
          required
          aria-label="Correo electrónico"
        />
        <input type="text" name="website" class="blog-hero__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button type="submit" class="btn" data-gtm-id="blog-subscribe-submit">Suscribirse</button>
      </form>
      <p class="blog-hero__capture-success" data-subscribe-success hidden role="status">
        ¡Gracias por suscribirte! Pronto recibirás nuestras novedades.
      </p>
    </div>
  </header>

  {posts.length === 0 ? (
    <section class="section">
      <div class="container">
        <p class="text-m">Pronto publicaremos nuevos artículos.</p>
      </div>
    </section>
  ) : (
    <section class="section blog-latest">
      <div class="container">
        <h2 class="blog-latest__heading">Últimos posts</h2>
        <div class="blog-latest__grid">
          <div class="blog-latest__featured">
            <BlogCard post={featured} variant="featured" />
          </div>
          {sidePosts.length > 0 && (
            <div class="blog-latest__side">
              {sidePosts.map((post) => <BlogCard post={post} variant="side" />)}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {morePosts.length > 0 && (
    <section class="section section--tight blog-all">
      <div class="container">
        <h2 class="blog-all__heading">Todos los posts</h2>
        <div class="blog-all__grid">
          {morePosts.map((post) => <BlogCard post={post} variant="grid" />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* ---- Encabezado ---- */
  .blog-hero {
    position: relative;
    overflow: hidden;
    background: var(--bg-base);
    padding-top: calc(var(--header-h) + 6rem);
    padding-bottom: 6rem;
  }
  .blog-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-7);
    max-width: 960px;
    margin-inline: auto;
    text-align: center;
  }
  .blog-hero__eyebrow {
    font-size: var(--fs-text-m);
    font-weight: var(--fw-semibold);
    color: var(--accent);
  }
  .blog-hero__title { color: var(--text-strong); margin: 0; font-weight: var(--fw-bold); }
  .blog-hero__sub { color: var(--text-body); max-width: 48rem; }

  .blog-hero__capture {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-9);
    width: 100%;
    max-width: 28rem;
    padding: var(--space-4) var(--space-4) var(--space-4) var(--space-6);
    border: 0.5px solid var(--neutro-250);
    border-radius: var(--radius-md);
    background: var(--neutro-100);
    color: var(--text-muted);
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .blog-hero__capture:hover,
  .blog-hero__capture:focus-within { border-color: var(--accent); }
  .blog-hero__hp { position: absolute !important; left: -9999px; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .blog-hero__capture-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    font-size: var(--fs-text-m);
    color: var(--text-strong);
    font-family: inherit;
  }
  .blog-hero__capture-input::placeholder { color: var(--text-muted); }
  .blog-hero__capture-input:focus { outline: none; }

  .blog-hero__capture[hidden] { display: none; }

  .blog-hero__capture-success {
    width: 100%;
    max-width: 28rem;
    margin-inline: auto;
    color: var(--success);
    font-weight: var(--fw-semibold);
  }

  /* ---- Últimos posts ---- */
  .blog-latest__heading {
    font-size: var(--fs-h-s);
    font-weight: var(--fw-bold);
    font-family: var(--font-heading);
    color: var(--text-strong);
    margin-bottom: var(--space-8);
  }
  .blog-latest__grid { display: flex; gap: var(--space-9); align-items: stretch; }
  .blog-latest__featured { flex: 1 1 0; min-width: 0; }
  .blog-latest__side {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-9);
  }

  /* ---- Todos los posts ---- */
  .blog-all { background: var(--bg-subtle); }
  .blog-all__heading {
    font-size: var(--fs-h-s);
    font-weight: var(--fw-bold);
    font-family: var(--font-heading);
    color: var(--text-strong);
    margin-bottom: var(--space-8);
  }
  .blog-all__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-8) var(--space-7); }

  @media (max-width: 980px) {
    .blog-latest__grid { flex-direction: column; }
  }
  @media (max-width: 900px) {
    .blog-all__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 744px) {
    .blog-hero { padding-block: var(--space-12); }
    .blog-hero__capture { flex-direction: column; align-items: stretch; gap: var(--space-4); }
  }
  @media (max-width: 620px) {
    .blog-all__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // URL del Google Apps Script (Web App) que agrega la fila a la hoja de cálculo.
  // Pega aquí la URL de tu implementación (termina en /exec). Mientras esté vacía,
  // el formulario confirma al usuario pero NO guarda nada.
  const SUBSCRIBE_URL = '';

  const form = document.querySelector<HTMLFormElement>('[data-subscribe]');
  const success = document.querySelector<HTMLElement>('[data-subscribe-success]');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const emailInput = form.querySelector<HTMLInputElement>('input[name="email"]');
    const email = emailInput?.value.trim() ?? '';
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      emailInput?.focus();
      return;
    }
    const hp = form.querySelector<HTMLInputElement>('input[name="website"]')?.value ?? '';
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (btn) { btn.disabled = true; btn.textContent = 'Enviando…'; }

    try {
      if (SUBSCRIBE_URL) {
        // mode 'no-cors': Apps Script no devuelve cabeceras CORS; enviamos y asumimos éxito.
        await fetch(SUBSCRIBE_URL, {
          method: 'POST',
          mode: 'no-cors',
          body: new URLSearchParams({ email, website: hp }),
        });
      } else {
        console.warn('[suscripción] Falta configurar SUBSCRIBE_URL con la URL del Apps Script.');
      }
    } catch (_) {
      /* no-cors no permite leer la respuesta; se asume enviado */
    }

    form.setAttribute('hidden', '');
    if (success) success.hidden = false;
  });
</script>
