---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout
  title="Blog"
  description="Artículos sobre confiabilidad, mantenimiento predictivo, integridad estructural y transformación digital en la industria minera e industrial."
>
  <PageHeader
    eyebrow="Conocimiento e industria"
    title="Blog Relengcorp"
    subtitle="Ideas, tendencias y mejores prácticas en confiabilidad, mantenimiento predictivo y transformación digital para la minería."
    breadcrumbs={[{ label: 'Blog' }]}
  />

  <section class="section">
    <div class="container">
      {posts.length === 0 ? (
        <p class="text-m">Pronto publicaremos nuevos artículos.</p>
      ) : (
        <div class="blog-index__grid">
          {posts.map((post) => <BlogCard post={post} />)}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-index__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-7); }
  @media (max-width: 900px) { .blog-index__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .blog-index__grid { grid-template-columns: 1fr; } }
</style>
