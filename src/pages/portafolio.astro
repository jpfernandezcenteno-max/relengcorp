---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import galleryManifest from '../data/portafolio-images.json';

// Casos reales de Relengcorp (https://relengcorp.com/portafolio/), organizados por categoría
// y conteo idénticos a la web: Servicios Especializados (9), Confiabilidad (11),
// Contratos Predictivos / CBM (1) y Paradas de Planta (5). Se conservan los proyectos
// que la web lista en más de una categoría o repetidos.
// Las imágenes (galería WebP optimizada) se enlazan por `slug` desde el manifiesto.
interface Project {
  slug: string;
  title: string;
  client: string;
  period: string;
  location?: string;
  description: string;
  result: string;
  category?: string;
  index?: number;
  image?: string;
  gallery?: string[];
}

const categories: { name: string; projects: Project[] }[] = [
  {
    name: 'Servicios Especializados',
    projects: [
      {
        slug: 'ultrasonido-phase-array-de-ciguenal',
        title: 'Ultrasonido Phase Array de cigüeñal',
        client: 'FLSmidth',
        period: '2024 · 2 días',
        description:
          'Inspección por ultrasonido Phase Array (PAUT) de cigüeñal para la detección de discontinuidades internas y la evaluación de su integridad estructural.',
        result: 'Cumplimiento de los resultados esperados en el tiempo programado.',
      },
      {
        slug: 'servicio-de-elongacion-de-pernos-quellaveco',
        title: 'Servicio de elongación de pernos – Quellaveco',
        client: 'FLSmidth',
        period: '2024 · 5 días',
        location: 'Quellaveco',
        description:
          'Medición de elongación de pernos inteligentes SPC4, que permiten reapretar y mantener la tensión de la unión cuantas veces sea necesario, reduciendo tiempos de mantenimiento, costos y reemplazo de piezas.',
