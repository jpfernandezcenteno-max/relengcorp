      },
    ],
  },
];

// Galerías reales (optimizadas a WebP) enlazadas por slug.
const manifest = galleryManifest as Record<string, string[]>;

// Índice global para enlazar tarjeta ↔ galería/ficha del modal.
const allProjects: Project[] = [];
categories.forEach((cat) => {
  cat.projects.forEach((p) => {
    p.category = cat.name;
    p.index = allProjects.length;
    p.gallery = (manifest[p.slug] ?? []).map((f) => `/images/portafolio/${f}`);
    p.image = p.gallery[0];
    allProjects.push(p);
  });
});
---
<BaseLayout
  title="Portafolio"
  description="Casos y proyectos ejecutados por Relengcorp en el sector minero e industrial: integridad estructural, mantenimiento predictivo, confiabilidad y más."
>
  <PageHeader
    eyebrow="Portafolio"
    title="Proyectos que sostienen operaciones críticas"
    subtitle="Una muestra de los servicios realizados para algunas de las operaciones más exigentes del sector minero e industrial."
    imageLabel="Proyecto en faena minera"
  />

  <section class="section">
    <div class="container portfolio-cats">
      {categories.map((cat) => (
        <div class="portfolio-cat">
          <h2 class="portfolio-cat__title h-m" data-reveal>{cat.name}</h2>
          <div class="portfolio-grid">
            {cat.projects.map((p) => (
              <button type="button" class="project-card" data-reveal data-project-trigger={p.index} aria-haspopup="dialog">
                <div class="project-card__inner">
                  <div class="project-card__media">
                    <img src={p.image} alt={p.title} class="project-card__img" loading="lazy" decoding="async" />
                    <span class="project-card__tag">{cat.name}</span>
                    {p.gallery!.length > 1 && (
                      <span class="project-card__count">
                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" aria-hidden="true"><path d="M3 16l5-5 4 4 3-3 6 6M3 5h18v14H3z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        {p.gallery!.length}
                      </span>
                    )}
                    <div class="project-card__overlay">
                      <span class="project-card__overlay-text">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M21 16v3a2 2 0 0 1-2 2h-3M8 21H5a2 2 0 0 1-2-2v-3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        Ver detalle
                      </span>
                    </div>
                  </div>
                  <div class="project-card__body">
                    <h3 class="h-xs">{p.title}</h3>
                    <p class="project-card__meta text-s">{p.client} · {p.period}</p>
                  </div>
                </div>
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ===== MODAL / FICHA DEL PROYECTO ===== -->
  <div class="project-modal" data-project-modal hidden>
    <div class="project-modal__backdrop" data-project-modal-close></div>
    <div class="project-modal__dialog" role="dialog" aria-modal="true" aria-label="Ficha del proyecto">
      <button type="button" class="project-modal__close" data-project-modal-close aria-label="Cerrar">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>

      <div class="project-modal__stage">
        {allProjects.flatMap((p) => p.gallery!.map((src, ii) => (
          <img class="project-modal__img" data-project={p.index} data-image={ii} src={src} alt={`${p.title} — imagen ${ii + 1}`} loading="lazy" decoding="async" hidden />
        )))}

        <button type="button" class="project-modal__nav project-modal__nav--prev" data-gallery-prev aria-label="Imagen anterior" hidden>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="project-modal__nav project-modal__nav--next" data-gallery-next aria-label="Imagen siguiente" hidden>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <span class="project-modal__counter" hidden><span data-gallery-current>1</span> / <span data-gallery-total>1</span></span>

        <div class="project-modal__thumbs" hidden>
          {allProjects.map((p) => (
            <div class="project-modal__thumbgroup" data-project={p.index} hidden>
              {p.gallery!.map((src, ii) => (
                <button type="button" class="project-modal__thumb" data-project={p.index} data-image={ii} aria-label={`Ver imagen ${ii + 1}`}>
                  <img src={src} alt="" loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
          ))}
        </div>
      </div>

      <div class="project-modal__body">
        {allProjects.map((p) => (
          <div class="project-modal__detail" data-project={p.index} hidden>
            <p class="project-modal__cat">{p.category}</p>
            <h3 class="project-modal__title">{p.title}</h3>
            <dl class="project-modal__meta">
              <div><dt>Cliente</dt><dd>{p.client}</dd></div>
              <div><dt>Año</dt><dd>{p.period}</dd></div>
              {p.location && <div><dt>Ubicación</dt><dd>{p.location}</dd></div>}
            </dl>
            <p class="project-modal__desc">{p.description}</p>
            <p class="project-modal__result">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {p.result}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <section class="section section-dark on-dark portfolio-cta">
    <div class="container portfolio-cta__inner">
      <div data-reveal>
        <h2 class="h-l">¿Tu operación necesita una solución a medida?</h2>
        <p class="text-m">Conversemos sobre tu próximo proyecto de confiabilidad.</p>
      </div>
      <a href="/contacto" class="btn btn--lg" data-reveal>Iniciar conversación</a>
    </div>
  </section>
</BaseLayout>

<style>
  .portfolio-cats { display: flex; flex-direction: column; gap: var(--space-12); }
  .portfolio-cat__title { color: var(--text-strong); margin-bottom: var(--space-6); }

  .portfolio-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-7); }
  .project-card {
    display: block; width: 100%; text-align: left; font: inherit; color: inherit; cursor: pointer;
    background: none; border: none; padding: 0;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .project-card:hover,
  .project-card:focus-visible { transform: translateY(-6px); }
  .project-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .project-card__inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden;
    transition: box-shadow var(--dur-base) var(--ease-out);
  }
  .project-card:hover .project-card__inner,
  .project-card:focus-visible .project-card__inner { box-shadow: var(--shadow-5); }
  .project-card__media { position: relative; flex-shrink: 0; }
  .project-card__img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: var(--bg-dark); }
  .project-card__tag { position: absolute; top: var(--space-4); left: var(--space-4); background: var(--accent); color: #fff; font-size: var(--fs-text-xs); font-weight: var(--fw-semibold); padding: 4px 12px; border-radius: var(--radius-pill); }
  .project-card__count {
    position: absolute; bottom: var(--space-4); right: var(--space-4);
    display: inline-flex; align-items: center; gap: 4px;
    background: rgba(8,10,20,0.7); color: #fff;
    font-size: var(--fs-text-xs); font-weight: var(--fw-semibold);
    padding: 3px 9px; border-radius: var(--radius-pill);
  }
  .project-card__overlay {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    background: rgba(28, 29, 45, 0.55);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .project-card:hover .project-card__overlay,
  .project-card:focus-visible .project-card__overlay { opacity: 1; }
  .project-card__overlay-text {
    display: flex; align-items: center; gap: var(--space-2);
    color: #fff; font-weight: var(--fw-semibold); font-size: var(--fs-text-s);
    border: 1px solid rgba(255,255,255,0.5); border-radius: var(--radius-pill);
    padding: var(--space-3) var(--space-5);
  }
  .project-card__body { padding: var(--space-6); display: flex; flex-direction: column; justify-content: flex-start; gap: var(--space-2); flex: 1; }
  .project-card__meta { color: var(--text-muted); margin-top: auto; }

  .portfolio-cta__inner { display: flex; justify-content: space-between; align-items: center; gap: var(--space-8); flex-wrap: wrap; }
  .portfolio-cta__inner h2 { color: #fff; }
  .portfolio-cta__inner p { color: var(--azul-100); margin-top: var(--space-3); }

  @media (max-width: 900px) { .portfolio-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .portfolio-grid { grid-template-columns: 1fr; } }

  /* ===== MODAL / FICHA ===== */
  .project-modal {
    position: fixed; inset: 0; z-index: var(--z-modal);
    display: flex; align-items: center; justify-content: center;
    padding: var(--space-6);
  }
  .project-modal[hidden] { display: none; }
  .project-modal__backdrop {
    position: absolute; inset: 0;
    background: rgba(11, 12, 22, 0.78);
    backdrop-filter: blur(4px);
  }
  .project-modal__dialog {
    position: relative;
    width: 100%; max-width: 940px;
    max-height: 92vh;
    background: var(--bg-dark);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex; flex-direction: column;
    box-shadow: var(--shadow-5);
  }
  .project-modal__close {
    position: absolute; top: var(--space-4); right: var(--space-4); z-index: 4;
    display: grid; place-items: center;
    width: 42px; height: 42px;
    border: none; border-radius: var(--radius-pill);
    background: rgba(8,10,20,0.55); color: #fff; cursor: pointer;
    backdrop-filter: blur(6px);
    transition: background var(--dur-fast) var(--ease-out);
  }
  .project-modal__close:hover { background: rgba(8,10,20,0.85); }

  /* Escenario de imagen con miniaturas superpuestas */
  .project-modal__stage {
    position: relative; flex-shrink: 0;
    background: #05060c;
    display: flex; align-items: center; justify-content: center;
    min-height: 220px;
  }
  .project-modal__img { display: block; max-width: 100%; max-height: 60vh; object-fit: contain; margin: 0 auto; }
  .project-modal__img[hidden] { display: none; }

  .project-modal__nav {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 2;
    display: grid; place-items: center; width: 40px; height: 40px;
    border: none; border-radius: var(--radius-pill);
    background: rgba(255,255,255,0.14); color: #fff; cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .project-modal__nav:hover { background: rgba(255,255,255,0.28); }
  .project-modal__nav--prev { left: var(--space-3); }
  .project-modal__nav--next { right: var(--space-3); }
  .project-modal__nav[hidden] { display: none; }

  .project-modal__counter {
    position: absolute; top: var(--space-4); left: var(--space-4); z-index: 2;
    background: rgba(8,10,20,0.6); color: #fff; font-size: var(--fs-text-xs);
    padding: 3px 10px; border-radius: var(--radius-pill); backdrop-filter: blur(6px);
  }
  .project-modal__counter[hidden] { display: none; }

  /* Miniaturas: tira flotante semitransparente sobre la imagen */
  .project-modal__thumbs {
    position: absolute; left: 50%; bottom: var(--space-4); transform: translateX(-50%); z-index: 3;
    display: flex; gap: var(--space-2);
    max-width: calc(100% - var(--space-8));
    padding: 6px; border-radius: var(--radius-lg);
    background: rgba(8, 10, 20, 0.42);
    border: 1px solid rgba(255,255,255,0.12);
    backdrop-filter: blur(8px);
    overflow-x: auto; scrollbar-width: none;
  }
  .project-modal__thumbs::-webkit-scrollbar { display: none; }
  .project-modal__thumbs[hidden] { display: none; }
  .project-modal__thumbgroup { display: contents; }
  .project-modal__thumbgroup[hidden] { display: none; }
  .project-modal__thumb {
    flex: 0 0 auto; width: 54px; height: 40px; padding: 0; cursor: pointer;
    border: 2px solid transparent; border-radius: var(--radius-sm); overflow: hidden;
    background: #05060c; opacity: 0.5;
    transition: opacity var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .project-modal__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .project-modal__thumb:hover { opacity: 0.9; transform: translateY(-2px); }
  .project-modal__thumb[aria-current='true'] { opacity: 1; border-color: var(--accent); }

  .project-modal__body { padding: var(--space-7); overflow: hidden; }
  .project-modal__detail { display: flex; flex-direction: column; gap: var(--space-4); }
  .project-modal__detail[hidden] { display: none; }
  .project-modal__cat { color: var(--celeste-300); font-size: var(--fs-text-xs); font-weight: var(--fw-semibold); letter-spacing: var(--tracking-wide); text-transform: uppercase; margin: 0; }
  .project-modal__title { color: #fff; font-size: var(--fs-h-s); margin: 0; }
  .project-modal__meta {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--space-4);
    margin: 0; padding: var(--space-5) 0; border-block: 1px solid rgba(255,255,255,0.12);
  }
  .project-modal__meta dt { color: var(--azul-200); font-size: var(--fs-text-xs); text-transform: uppercase; letter-spacing: var(--tracking-wide); margin-bottom: 2px; }
  .project-modal__meta dd { color: #fff; font-size: var(--fs-text-s); font-weight: var(--fw-medium); margin: 0; }
  .project-modal__desc { color: var(--azul-100); font-size: var(--fs-text-m); line-height: 1.7; margin: 0; }
  .project-modal__result {
    display: flex; align-items: flex-start; gap: var(--space-2);
    color: var(--celeste-300); font-weight: var(--fw-semibold); font-size: var(--fs-text-s); margin: 0;
  }
  .project-modal__result svg { flex-shrink: 0; margin-top: 2px; }

  @media (max-width: 560px) {
    .project-modal { padding: var(--space-3); }
    .project-modal__body { padding: var(--space-6); }
    .project-modal__img { max-height: 46vh; }
    .project-modal__thumb { width: 46px; height: 34px; }
  }
</style>

<script>
  const triggers = document.querySelectorAll<HTMLButtonElement>('[data-project-trigger]');
  const modal = document.querySelector<HTMLElement>('[data-project-modal]');
  const stageImgs = document.querySelectorAll<HTMLElement>('.project-modal__img');
  const thumbgroups = document.querySelectorAll<HTMLElement>('.project-modal__thumbgroup');
  const thumbs = document.querySelectorAll<HTMLButtonElement>('.project-modal__thumb');
  const details = document.querySelectorAll<HTMLElement>('.project-modal__detail');
  const thumbsBox = modal?.querySelector<HTMLElement>('.project-modal__thumbs') ?? null;
  const prevBtn = modal?.querySelector<HTMLElement>('[data-gallery-prev]') ?? null;
  const nextBtn = modal?.querySelector<HTMLElement>('[data-gallery-next]') ?? null;
  const counter = modal?.querySelector<HTMLElement>('.project-modal__counter') ?? null;
  const curEl = modal?.querySelector<HTMLElement>('[data-gallery-current]') ?? null;
  const totEl = modal?.querySelector<HTMLElement>('[data-gallery-total]') ?? null;
  const closeEls = document.querySelectorAll<HTMLElement>('[data-project-modal-close]');

  let cp = 0; // proyecto actual
  let ci = 0; // imagen actual
  let total = 1;

  const render = () => {
    stageImgs.forEach((img) => {
      img.hidden = !(img.dataset.project === String(cp) && img.dataset.image === String(ci));
    });
    thumbs.forEach((t) => {
      const isCurrent = t.dataset.project === String(cp) && t.dataset.image === String(ci);
      if (isCurrent) t.setAttribute('aria-current', 'true');
      else t.removeAttribute('aria-current');
    });
    if (curEl) curEl.textContent = String(ci + 1);
  };

  const open = (index: number) => {
    cp = index;
    ci = 0;
    total = document.querySelectorAll(`.project-modal__img[data-project="${index}"]`).length;
    thumbgroups.forEach((g) => { g.hidden = g.dataset.project !== String(index); });
    details.forEach((d) => { d.hidden = d.dataset.project !== String(index); });
    if (totEl) totEl.textContent = String(total);
    const multi = total > 1;
    if (prevBtn) prevBtn.hidden = !multi;
    if (nextBtn) nextBtn.hidden = !multi;
    if (counter) counter.hidden = !multi;
    if (thumbsBox) thumbsBox.hidden = !multi;
    render();
    modal?.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
  };

  const close = () => {
    modal?.setAttribute('hidden', '');
    document.body.style.overflow = '';
  };

  const step = (delta: number) => {
    if (total < 2) return;
    ci = (ci + delta + total) % total;
    render();
  };

  triggers.forEach((btn) => {
    btn.addEventListener('click', () => open(Number(btn.dataset.projectTrigger)));
  });
  thumbs.forEach((t) => {
    t.addEventListener('click', () => {
      if (t.dataset.project !== String(cp)) return;
      ci = Number(t.dataset.image);
      render();
    });
  });
  prevBtn?.addEventListener('click', () => step(-1));
  nextBtn?.addEventListener('click', () => step(1));
  closeEls.forEach((el) => el.addEventListener('click', close));
  document.addEventListener('keydown', (e) => {
    if (modal?.hasAttribute('hidden')) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowLeft') step(-1);
    else if (e.key === 'ArrowRight') step(1);
  });
</script>
