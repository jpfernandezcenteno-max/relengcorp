---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { services } from '../data/site';

// PLACEHOLDER: proyectos de ejemplo. Reemplazar por casos reales del cliente
// (servicios realizados con foto, cliente, alcance y resultado).
const projects = [
  {
    title: 'Inspección de integridad de molinos',
    sector: 'Minería de cobre',
    service: 'Integridad Estructural',
    photos: ['Vista general del molino', 'Inspección de soldaduras', 'Equipo en terreno', 'Informe de hallazgos'],
  },
  {
    title: 'Monitoreo predictivo de activos críticos',
    sector: 'Planta concentradora',
    service: 'Mantenimiento Predictivo',
    photos: ['Sensorización de equipos', 'Sala de monitoreo', 'Análisis de vibraciones', 'Tablero de condición'],
  },
  {
    title: 'Análisis RAM y gestión de riesgo',
    sector: 'Operación minera',
    service: 'Ingeniería de Confiabilidad',
    photos: ['Levantamiento de datos', 'Modelo de confiabilidad', 'Taller con el cliente', 'Plan de acción'],
  },
  {
    title: 'Centro de confiabilidad remota',
    sector: 'Multi-faena',
    service: 'Confiabilidad Inteligente',
    photos: ['Centro de operaciones', 'Visualización en tiempo real', 'Equipo multidisciplinario', 'Alertas tempranas', 'Reporte ejecutivo'],
  },
  {
    title: 'Certificación de tuberías de relaves',
    sector: 'Transporte de relaves',
    service: 'Integridad Estructural',
    photos: ['Recorrido de ducto', 'Ensayo no destructivo', 'Punto crítico identificado', 'Certificación final'],
  },
  {
    title: 'Optimización metalúrgica con ML',
    sector: 'Laboratorio metalúrgico',
    service: 'Metalurgia Inteligente',
    photos: ['Toma de muestras', 'Laboratorio metalúrgico', 'Modelo predictivo', 'Resultados de optimización'],
  },
];
---
<BaseLayout
  title="Portafolio"
  description="Casos y proyectos ejecutados por Relengcorp en el sector minero e industrial: integridad estructural, mantenimiento predictivo, confiabilidad y más."
>
  <PageHeader
    eyebrow="Portafolio"
    title="Proyectos que sostienen operaciones críticas"
    subtitle="Una muestra de los servicios realizados para algunas de las operaciones más exigentes del sector minero e industrial."
    imageLabel="Proyecto en faena minera"
  />

  <section class="section">
    <div class="container">
      <div class="portfolio-grid">
        {projects.map((p, i) => (
          <button type="button" class="project-card" data-reveal data-project-trigger={i} data-title={p.title} aria-haspopup="dialog">
            <div class="project-card__inner">
              <div class="project-card__media">
                <ImagePlaceholder label={`${p.title} — foto del proyecto`} ratio="4/3" tone="dark" />
                <span class="project-card__tag">{p.service}</span>
                <span class="project-card__count">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" aria-hidden="true"><path d="M3 16l5-5 4 4 3-3 6 6M3 5h18v14H3z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {p.photos.length}
                </span>
                <div class="project-card__overlay">
                  <span class="project-card__overlay-text">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M21 16v3a2 2 0 0 1-2 2h-3M8 21H5a2 2 0 0 1-2-2v-3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Ver galería
                  </span>
                </div>
              </div>
              <div class="project-card__body">
                <h3 class="h-xs">{p.title}</h3>
                <p class="text-s project-card__sector">{p.sector}</p>
              </div>
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== MODAL DE GALERÍA DEL PROYECTO ===== -->
  <div class="project-modal" data-project-modal hidden>
    <div class="project-modal__backdrop" data-project-modal-close></div>
    <div class="project-modal__dialog" role="dialog" aria-modal="true" aria-label="Galería del proyecto">
      <button type="button" class="project-modal__close" data-project-modal-close aria-label="Cerrar galería">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>

      <div class="project-modal__viewer">
        <button type="button" class="project-modal__nav project-modal__nav--prev" data-gallery-prev aria-label="Foto anterior">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="project-modal__main">
          {projects.map((p, pi) => p.photos.map((photo, ii) => (
            <div class="project-modal__image" data-project={pi} data-image={ii} hidden>
              <ImagePlaceholder label={photo} ratio="16/9" tone="dark" rounded={false} />
            </div>
          )))}
        </div>
        <button type="button" class="project-modal__nav project-modal__nav--next" data-gallery-next aria-label="Foto siguiente">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>

      <div class="project-modal__footer">
        <div class="project-modal__info">
          <h3 class="project-modal__title" data-project-title></h3>
          <p class="project-modal__counter"><span data-project-current>1</span> / <span data-project-total></span></p>
        </div>
        <div class="project-modal__thumbs">
          {projects.map((p, pi) => (
            <div class="project-modal__thumbgroup" data-project={pi}>
              {p.photos.map((photo, ii) => (
                <button type="button" class="project-modal__thumb" data-project={pi} data-image={ii} aria-label={`Ver foto ${ii + 1}: ${photo}`}>
                  <ImagePlaceholder label={photo} ratio="1/1" tone="dark" />
                </button>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <section class="section section-dark on-dark portfolio-cta">
    <div class="container portfolio-cta__inner">
      <div data-reveal>
        <h2 class="h-l">¿Tu operación necesita una solución a medida?</h2>
        <p class="text-m">Conversemos sobre tu próximo proyecto de confiabilidad.</p>
      </div>
      <a href="/contacto" class="btn btn--lg" data-reveal>Iniciar conversación</a>
    </div>
  </section>
</BaseLayout>

<style>
  .portfolio-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-7); }
  .project-card {
    display: block; width: 100%; text-align: left; font: inherit; color: inherit; cursor: pointer;
    background: none; border: none; padding: 0;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .project-card:hover,
  .project-card:focus-visible { transform: translateY(-6px); }
  .project-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .project-card__inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden;
    transition: box-shadow var(--dur-base) var(--ease-out);
  }
  .project-card:hover .project-card__inner,
  .project-card:focus-visible .project-card__inner { box-shadow: var(--shadow-5); }
  .project-card__media { position: relative; flex-shrink: 0; }
  .project-card__tag { position: absolute; top: var(--space-4); left: var(--space-4); background: var(--accent); color: #fff; font-size: var(--fs-text-xs); font-weight: var(--fw-semibold); padding: 4px 12px; border-radius: var(--radius-pill); }
  .project-card__count {
    position: absolute; bottom: var(--space-4); right: var(--space-4);
    display: inline-flex; align-items: center; gap: 4px;
    background: rgba(28, 29, 45, 0.65); color: #fff;
    font-size: var(--fs-text-xs); font-weight: var(--fw-semibold);
    padding: 4px 10px; border-radius: var(--radius-pill);
  }
  .project-card__overlay {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    background: rgba(28, 29, 45, 0.55);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .project-card:hover .project-card__overlay,
  .project-card:focus-visible .project-card__overlay { opacity: 1; }
  .project-card__overlay-text {
    display: flex; align-items: center; gap: var(--space-2);
    color: #fff; font-weight: var(--fw-semibold); font-size: var(--fs-text-s);
    border: 1px solid rgba(255,255,255,0.5); border-radius: var(--radius-pill);
    padding: var(--space-3) var(--space-5);
  }
  .project-card__body { padding: var(--space-6); display: flex; flex-direction: column; justify-content: center; gap: var(--space-2); flex: 1; }
  .project-card__sector { color: var(--text-muted); }

  .portfolio-cta__inner { display: flex; justify-content: space-between; align-items: center; gap: var(--space-8); flex-wrap: wrap; }
  .portfolio-cta__inner h2 { color: #fff; }
  .portfolio-cta__inner p { color: var(--azul-100); margin-top: var(--space-3); }

  @media (max-width: 900px) { .portfolio-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .portfolio-grid { grid-template-columns: 1fr; } }

  /* ===== MODAL DE GALERÍA ===== */
  .project-modal {
    position: fixed; inset: 0; z-index: var(--z-modal);
    display: flex; align-items: center; justify-content: center;
    padding: var(--space-6);
  }
  .project-modal[hidden] { display: none; }
  .project-modal__backdrop {
    position: absolute; inset: 0;
    background: rgba(11, 12, 22, 0.75);
    backdrop-filter: blur(4px);
  }
  .project-modal__dialog {
    position: relative;
    width: 100%; max-width: 860px;
    max-height: 90vh;
    background: var(--bg-dark);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex; flex-direction: column;
    box-shadow: var(--shadow-5);
  }
  .project-modal__close {
    position: absolute; top: var(--space-4); right: var(--space-4); z-index: 2;
    display: grid; place-items: center;
    width: 40px; height: 40px;
    border: none; border-radius: var(--radius-pill);
    background: rgba(255,255,255,0.12); color: #fff; cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .project-modal__close:hover { background: rgba(255,255,255,0.22); }

  .project-modal__viewer { position: relative; display: flex; align-items: center; }
  .project-modal__main { flex: 1; min-width: 0; }
  .project-modal__image { width: 100%; }
  .project-modal__image[hidden] { display: none; }
  .project-modal__image :global(.ph) { border-radius: 0; }

  .project-modal__nav {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 2;
    display: grid; place-items: center;
    width: 40px; height: 40px;
    border: none; border-radius: var(--radius-pill);
    background: rgba(255,255,255,0.12); color: #fff; cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .project-modal__nav:hover { background: rgba(255,255,255,0.22); }
  .project-modal__nav--prev { left: var(--space-4); }
  .project-modal__nav--next { right: var(--space-4); }

  .project-modal__footer { padding: var(--space-5) var(--space-6); display: flex; flex-direction: column; gap: var(--space-4); }
  .project-modal__info { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); }
  .project-modal__title { color: #fff; font-size: var(--fs-h-xs); margin: 0; }
  .project-modal__counter { color: var(--azul-200); font-size: var(--fs-text-s); white-space: nowrap; }

  .project-modal__thumbs { display: flex; gap: var(--space-3); overflow-x: auto; padding-bottom: 2px; }
  .project-modal__thumbgroup { display: contents; }
  .project-modal__thumbgroup[hidden] { display: none; }
  .project-modal__thumb {
    flex-shrink: 0; width: 64px; height: 64px;
    border: 2px solid transparent; border-radius: var(--radius-md); overflow: hidden;
    padding: 0; cursor: pointer; opacity: 0.55;
    transition: opacity var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .project-modal__thumb :global(.ph) { height: 100%; border-radius: 0; padding: var(--space-2); }
  .project-modal__thumb:hover { opacity: 0.85; }
  .project-modal__thumb[aria-current='true'] { opacity: 1; border-color: var(--accent); }

  @media (max-width: 620px) {
    .project-modal__nav { width: 34px; height: 34px; }
    .project-modal__info { flex-direction: column; gap: var(--space-1); }
  }
</style>

<script>
  const projectButtons = document.querySelectorAll<HTMLButtonElement>('[data-project-trigger]');
  const modal = document.querySelector<HTMLElement>('[data-project-modal]');
  const images = document.querySelectorAll<HTMLElement>('.project-modal__image');
  const thumbgroups = document.querySelectorAll<HTMLElement>('.project-modal__thumbgroup');
  const thumbs = document.querySelectorAll<HTMLButtonElement>('.project-modal__thumb');
  const titleEl = document.querySelector<HTMLElement>('[data-project-title]');
  const currentEl = document.querySelector<HTMLElement>('[data-project-current]');
  const totalEl = document.querySelector<HTMLElement>('[data-project-total]');
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-gallery-prev]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-gallery-next]');
  const closeEls = document.querySelectorAll<HTMLElement>('[data-project-modal-close]');

  let currentProject = 0;
  let currentImage = 0;
  let totalImages = 0;

  const render = () => {
    images.forEach((img) => {
      img.hidden = !(img.dataset.project === String(currentProject) && img.dataset.image === String(currentImage));
    });
    thumbgroups.forEach((g) => {
      g.hidden = g.dataset.project !== String(currentProject);
    });
    thumbs.forEach((t) => {
      const isCurrent = t.dataset.project === String(currentProject) && t.dataset.image === String(currentImage);
      if (isCurrent) t.setAttribute('aria-current', 'true');
      else t.removeAttribute('aria-current');
    });
    if (currentEl) currentEl.textContent = String(currentImage + 1);
  };

  const open = (projectIndex: number) => {
    currentProject = projectIndex;
    currentImage = 0;
    totalImages = document.querySelectorAll(`.project-modal__image[data-project="${projectIndex}"]`).length;
    if (titleEl) titleEl.textContent = projectButtons[projectIndex]?.dataset.title ?? '';
    if (totalEl) totalEl.textContent = String(totalImages);
    render();
    modal?.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
  };

  const close = () => {
    modal?.setAttribute('hidden', '');
    document.body.style.overflow = '';
  };

  const step = (delta: number) => {
    currentImage = (currentImage + delta + totalImages) % totalImages;
    render();
  };

  projectButtons.forEach((btn, i) => btn.addEventListener('click', () => open(i)));
  closeEls.forEach((el) => el.addEventListener('click', close));
  prevBtn?.addEventListener('click', () => step(-1));
  nextBtn?.addEventListener('click', () => step(1));
  thumbs.forEach((t) => {
    t.addEventListener('click', () => {
      currentImage = Number(t.dataset.image);
      render();
    });
  });
  document.addEventListener('keydown', (e) => {
    if (modal?.hasAttribute('hidden')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });
</script>
