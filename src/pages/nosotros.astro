---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { certifications, homologations } from '../data/site';

const values = [
  { title: 'Seguridad', tagline: 'Primero', desc: 'La seguridad es nuestra prioridad en cada actividad y decisión. Protegemos a las personas, promoviendo una cultura preventiva y responsable orientada al cero daño.' },
  { title: 'Integridad', tagline: 'Siempre', desc: 'Actuamos con honestidad, transparencia y coherencia en todo momento. Cumplimos nuestros compromisos y hacemos lo correcto, generando confianza con clientes y colaboradores.' },
  { title: 'Innovación', tagline: 'Que genere valor', desc: 'Impulsamos soluciones que integran tecnología, digitalización e inteligencia artificial para resolver desafíos reales y generar valor sostenible en las operaciones de nuestros clientes.' },
  { title: 'Enfoque al cliente', tagline: 'Soluciones que transforman', desc: 'Entendemos las necesidades de nuestros clientes para entregar soluciones confiables, eficientes y de alto impacto, mejorando su productividad y competitividad.' },
  { title: 'Excelencia', tagline: 'En todo lo que hacemos', desc: 'Trabajamos con disciplina, calidad y mejora continua para superar expectativas y entregar servicios de alto nivel en cada proyecto y operación.' },
  { title: 'Actitud', tagline: 'Trabajo en equipo', desc: 'Trabajamos juntos para crear una cultura basada en la confianza y el respeto.' },
];

const policies = [
  { title: 'Integrada de Gestión', desc: 'Brindamos servicios con calidad, promoviendo la seguridad, el cuidado del medio ambiente y la mejora continua en nuestras operaciones.' },
  { title: 'Igualdad de Género', desc: 'Promovemos la igualdad de oportunidades y el respeto, garantizando un entorno laboral inclusivo y libre de discriminación.' },
  { title: 'Hostigamiento Sexual', desc: 'Rechazamos todo acto de hostigamiento, promoviendo un ambiente laboral seguro, respetuoso y libre de violencia.' },
  { title: 'Sostenibilidad', desc: 'Desarrollamos nuestras actividades de manera responsable, promoviendo el cuidado ambiental, social y económico.' },
  { title: 'Derechos Humanos', desc: 'Respetamos y promovemos los derechos humanos, garantizando un trato digno, justo y equitativo para todas las personas.' },
  { title: 'Responsabilidad Social', desc: 'Impulsamos la contratación local y la capacitación técnica para generar mayores oportunidades laborales.' },
  { title: 'Anticorrupción', desc: 'Nuestro éxito se basa en la confianza de nuestros clientes, construida con honestidad y seriedad comercial.' },
];
---
<BaseLayout
  title="Nosotros"
  description="Relengcorp es una empresa especializada en soluciones integrales de confiabilidad, mantenimiento, monitoreo de condición y transformación digital para la industria minera e industrial."
>
  <PageHeader
    eyebrow="Quiénes somos"
    title="Transformamos la confiabilidad en una gestión inteligente y predictiva"
    subtitle="Ayudamos a nuestros clientes a maximizar la disponibilidad de sus activos, optimizar sus procesos y mejorar su desempeño operativo mediante servicios especializados, tecnologías avanzadas e inteligencia aplicada."
    breadcrumbs={[{ label: 'Nosotros' }]}
  />

  <!-- Quiénes somos -->
  <section class="section">
    <div class="container about-intro">
      <div class="about-intro__text" data-reveal>
        <p class="eyebrow">Sobre Relengcorp</p>
        <h2 class="h-m">Confiabilidad, integridad y transformación digital para la industria</h2>
        <p class="text-m">
          Relengcorp es una empresa especializada en soluciones integrales de confiabilidad,
          mantenimiento, monitoreo de condición y transformación digital para la industria
          minera e industrial. Nuestro compromiso es generar valor sostenible, reducir riesgos
          operacionales y contribuir al crecimiento eficiente y seguro de las organizaciones.
        </p>
      </div>
      <div class="about-intro__media" data-reveal>
        <ImagePlaceholder label="Equipo Relengcorp / instalaciones" ratio="4/3" tone="dark" />
      </div>
    </div>
  </section>

  <!-- Misión / Visión -->
  <section class="section section--tight section-dark on-dark">
    <div class="container mv-grid">
      <article class="mv-card" data-reveal>
        <span class="mv-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="1" fill="currentColor"/></svg>
        </span>
        <h2 class="h-s">Misión</h2>
        <p class="text-m">
          Transformar la confiabilidad en una gestión inteligente, predictiva y digital,
          integrando el monitoreo de condición especializado, sensorización remota e
          inteligencia artificial aplicada para anticiparnos a las fallas y maximizar la
          disponibilidad y confiabilidad de los activos críticos de nuestros clientes.
        </p>
      </article>
      <article class="mv-card" data-reveal>
        <span class="mv-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6"/></svg>
        </span>
        <h2 class="h-s">Visión</h2>
        <p class="text-m">
          Ser líderes en confiabilidad inteligente e integridad estructural para la minería,
          desarrollando soluciones predictivas y tecnologías avanzadas que transformen la
          manera en que se gestionan los activos críticos.
        </p>
      </article>
    </div>
  </section>

  <!-- Valores -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow eyebrow--center">Nuestros valores</p>
        <h2 class="h-l">Los principios que guían cada operación</h2>
      </div>
      <div class="values-grid">
        {values.map((v) => (
          <article class="value-card" data-reveal>
            <h3 class="value-card__title h-xs">{v.title}<span class="value-card__tag">{v.tagline}</span></h3>
            <p class="text-s">{v.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Políticas -->
  <section class="section section-subtle policies">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow eyebrow--center">Nuestras políticas</p>
        <h2 class="h-l">Compromiso con la gestión responsable</h2>
      </div>
      <div class="policies-grid">
        {policies.map((p, i) => (
          <article class="policy-card" data-reveal>
            <span class="policy-card__num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="h-xs">{p.title}</h3>
              <p class="text-s">{p.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Trinorma + Homologaciones -->
  <section class="section certs-about">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow eyebrow--center">Nuestra trinorma</p>
        <h2 class="h-l">Estándares internacionales que nos respaldan</h2>
        <p class="text-m">
          Nuestras operaciones se desarrollan bajo normas ISO que garantizan confiabilidad,
          eficiencia y excelencia operativa en cada proyecto.
        </p>
      </div>
      <ul class="trinorma">
        {certifications.map((c) => (
          <li class="trinorma__item" data-reveal>
            <span class="trinorma__check" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="trinorma__code">{c.code}</span>
            <span class="trinorma__scope text-s">{c.scope}</span>
          </li>
        ))}
      </ul>
      <div class="homolog" data-reveal>
        <p class="homolog__label">Homologaciones y evaluaciones empresariales:</p>
        <ul>{homologations.map((h) => <li>{h}</li>)}</ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-intro { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: var(--space-9); align-items: center; }
  .about-intro__text { display: flex; flex-direction: column; gap: var(--space-5); }

  .mv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-7); }
  .mv-card { padding: var(--space-8); border-radius: var(--radius-lg); background: rgba(255,255,255,0.04); border: 1px solid var(--border-dark); display: flex; flex-direction: column; gap: var(--space-4); }
  .mv-card h2 { color: #fff; }
  .mv-card p { color: var(--azul-100); }
  .mv-card__icon { display: grid; place-items: center; width: 56px; height: 56px; border-radius: var(--radius-md); background: rgba(0,172,229,0.18); color: var(--celeste-300); }

  .values-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .value-card { padding: var(--space-7); border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); border-top: 3px solid var(--accent); transition: box-shadow var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out); }
  .value-card:hover { box-shadow: var(--shadow-4); transform: translateY(-4px); }
  .value-card__title { display: flex; flex-direction: column; gap: 2px; margin-bottom: var(--space-4); }
  .value-card__tag { font-size: var(--fs-text-s); font-weight: var(--fw-medium); color: var(--accent); }

  .policies { background: var(--bg-subtle); }
  .policies-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-6); }
  .policy-card { display: flex; gap: var(--space-5); padding: var(--space-6); background: var(--surface); border-radius: var(--radius-lg); border: 1px solid var(--border); }
  .policy-card__num { font-size: var(--fs-h-s); font-weight: var(--fw-extrabold); color: var(--accent-soft); -webkit-text-stroke: 1px var(--accent); color: transparent; line-height: 1; }
  .policy-card h3 { margin-bottom: var(--space-3); }

  .trinorma { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); margin-top: var(--space-2); }
  .trinorma__item { display: flex; flex-direction: column; gap: var(--space-3); align-items: center; text-align: center; padding: var(--space-8); border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--border); box-shadow: var(--shadow-2); }
  .trinorma__check { display: grid; place-items: center; width: 52px; height: 52px; border-radius: var(--radius-md); background: var(--accent); color: #fff; }
  .trinorma__code { font-size: var(--fs-h-s); font-weight: var(--fw-extrabold); color: var(--text-strong); }
  .trinorma__scope { color: var(--text-body); }

  .homolog { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: var(--space-5); margin-top: var(--space-9); }
  .homolog__label { color: var(--text-muted); font-size: var(--fs-text-s); }
  .homolog ul { display: flex; flex-wrap: wrap; gap: var(--space-6); }
  .homolog li { font-weight: var(--fw-bold); letter-spacing: var(--tracking-wide); color: var(--text-strong); }

  @media (max-width: 900px) {
    .about-intro, .mv-grid, .values-grid, .policies-grid, .trinorma { grid-template-columns: 1fr; }
    .about-intro__media { order: -1; max-width: 520px; }
  }
  @media (max-width: 620px) { .values-grid { grid-template-columns: 1fr; } }
</style>
