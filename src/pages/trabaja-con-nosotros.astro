---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';

const reasons = [
  { title: 'Cultura de seguridad', desc: 'Trabajamos bajo una cultura preventiva orientada al cero daño, donde tu bienestar es lo primero.' },
  { title: 'Desarrollo técnico', desc: 'Crece junto a un equipo experto en confiabilidad, integridad estructural y transformación digital.' },
  { title: 'Proyectos de alto impacto', desc: 'Participa en operaciones críticas del sector minero e industrial con tecnología de punta.' },
  { title: 'Igualdad de oportunidades', desc: 'Promovemos un entorno laboral inclusivo, respetuoso y libre de discriminación.' },
];
---
<BaseLayout
  title="Trabaja con nosotros"
  description="Únete al equipo de Relengcorp. Impulsamos la contratación local y la capacitación técnica para generar mayores oportunidades laborales en la industria minera."
>
  <PageHeader
    eyebrow="Trabaja con nosotros"
    title="Construye el futuro de la confiabilidad inteligente"
    subtitle="Buscamos talento que comparta nuestra pasión por la excelencia, la seguridad y la innovación. Postula y forma parte de un equipo que transforma la industria."
    imageLabel="Equipo de trabajo Relengcorp"
  />

  <section class="section">
    <div class="container trabaja-grid">
      <div class="trabaja-reasons" data-reveal>
        <p class="eyebrow">¿Por qué Relengcorp?</p>
        <h2 class="h-m">Un lugar para crecer y generar impacto</h2>
        <ul class="reasons-list">
          {reasons.map((r) => (
            <li class="reason">
              <span class="reason__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <div>
                <h3 class="h-xs">{r.title}</h3>
                <p class="text-s">{r.desc}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="trabaja-form" data-reveal>
        <ContactForm
          variant="job"
          title="Postula aquí"
          description="Completa el formulario y adjunta tu CV. Revisaremos tu información y te contactaremos."
          submitLabel="Enviar postulación"
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .trabaja-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: var(--space-10); align-items: start; }
  .trabaja-reasons { display: flex; flex-direction: column; gap: var(--space-5); }
  .reasons-list { display: flex; flex-direction: column; gap: var(--space-6); margin-top: var(--space-4); }
  .reason { display: flex; gap: var(--space-4); align-items: flex-start; }
  .reason__icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: var(--radius-md); background: var(--accent-soft); color: var(--accent); flex-shrink: 0; }
  .reason h3 { margin-bottom: var(--space-2); }
  @media (max-width: 900px) { .trabaja-grid { grid-template-columns: 1fr; } }
</style>
