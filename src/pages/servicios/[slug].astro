---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import { services, site } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug).slice(0, 3);

// Schema.org Service para SEO
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.intro,
  provider: { '@type': 'Organization', name: site.legalName, url: site.url },
  areaServed: ['PE', 'CL'],
  serviceType: service.title,
};
---

<BaseLayout title={service.title} description={service.short} schema={schema}>
  <!-- HERO con formulario de captación (descarga de brochure) -->
  <section class="svc-hero">
    <div class="svc-hero__bg" aria-hidden="true"><div class="svc-hero__glow"></div></div>
    <div class="container svc-hero__inner">
      <div class="svc-hero__content">
        <nav class="breadcrumb" aria-label="Ruta de navegación">
          <ol>
            <li><a href="/">Inicio</a></li>
            <li><a href="/servicios">Servicios</a></li>
            <li><span aria-current="page">{service.title}</span></li>
          </ol>
        </nav>
        <span class="svc-hero__icon" data-reveal><ServiceIcon slug={service.slug} size={34} /></span>
        <p class="eyebrow" data-reveal>Servicios especializados</p>
        <h1 class="h-xl" data-reveal>{service.title}</h1>
        <p class="svc-hero__intro text-l" data-reveal>{service.intro}</p>
      </div>

      <div class="svc-hero__form" data-reveal>
        <ContactForm
          variant="service"
          serviceName={service.title}
          title="Descarga el brochure"
          description="Déjanos tus datos y recibe el brochure de este servicio. Un especialista te contactará."
          submitLabel="Descargar brochure"
        />
      </div>
    </div>
  </section>

  <!-- DETALLE: grupos de servicios -->
  <section class="section svc-detail">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Alcance del servicio</p>
        <h2 class="h-l">¿Qué incluye {service.title}?</h2>
      </div>

      <div class="svc-groups">
        {service.groups.map((group) => (
          <div class="svc-group" data-reveal>
            <h3 class="svc-group__name h-xs">{group.name}</h3>
            <ul class="svc-group__list">
              {group.items.map((item) => (
                <li>
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFICIOS / imagen -->
  <section class="section section--tight svc-benefit">
    <div class="container svc-benefit__grid">
      <div class="svc-benefit__media" data-reveal>
        <ImagePlaceholder label={`${service.title} en operación`} ratio="4/3" tone="dark" />
      </div>
      <div class="svc-benefit__text" data-reveal>
        <p class="eyebrow">Por qué Relengcorp</p>
        <h2 class="h-m">Confiabilidad que se traduce en continuidad operacional</h2>
        <p class="text-m">
          Combinamos ingeniería especializada, tecnología avanzada e inteligencia aplicada para
          reducir riesgos, optimizar procesos y maximizar la disponibilidad de tus activos críticos.
        </p>
        <a href="/contacto" class="btn btn--lg">Conversemos sobre tu operación</a>
      </div>
    </div>
  </section>

  <!-- OTROS SERVICIOS -->
  <section class="section section-dark svc-others on-dark">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow eyebrow--center">Sigue explorando</p>
        <h2 class="h-l">Otros servicios especializados</h2>
      </div>
      <div class="svc-others__grid">
        {others.map((s) => (
          <a href={`/servicios/${s.slug}`} class="svc-others__card" data-reveal>
            <span class="svc-others__icon"><ServiceIcon slug={s.slug} /></span>
            <h3 class="h-xs">{s.title}</h3>
            <p class="text-s">{s.short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .svc-hero { position: relative; background: var(--gradient-hero); color: #fff; padding-top: calc(var(--header-h) + var(--space-9)); padding-bottom: var(--space-12); overflow: hidden; isolation: isolate; }
  .svc-hero__bg { position: absolute; inset: 0; z-index: -1; }
  .svc-hero__glow { position: absolute; top: -20%; left: -10%; width: 60%; height: 120%; background: var(--gradient-glow); }
  .svc-hero__inner { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: var(--space-10); align-items: start; }
  .svc-hero__content { display: flex; flex-direction: column; gap: var(--space-5); }
  .svc-hero__content h1 { color: #fff; }
  .svc-hero .eyebrow { color: var(--celeste-300); }
  .svc-hero__icon { display: grid; place-items: center; width: 64px; height: 64px; border-radius: var(--radius-lg); background: rgba(0,172,229,0.18); color: var(--celeste-300); }
  .svc-hero__intro { color: var(--azul-100); }
  .svc-hero .breadcrumb ol { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; margin-bottom: var(--space-2); }
  .svc-hero .breadcrumb li { display: flex; align-items: center; gap: var(--space-3); font-size: var(--fs-text-s); color: var(--azul-200); }
  .svc-hero .breadcrumb li + li::before { content: '/'; color: var(--azul-300); }
  .svc-hero .breadcrumb a { color: var(--azul-100); }
  .svc-hero .breadcrumb [aria-current] { color: #fff; }

  /* Detalle */
  .svc-groups { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-6); }
  .svc-group { padding: var(--space-7); border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); transition: box-shadow var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out); }
  .svc-group:hover { box-shadow: var(--shadow-4); transform: translateY(-4px); }
  .svc-group__name { color: var(--accent); margin-bottom: var(--space-5); }
  .svc-group__list { display: flex; flex-direction: column; gap: var(--space-4); }
  .svc-group__list li { display: flex; gap: var(--space-3); align-items: flex-start; color: var(--text-body); }
  .svc-group__list svg { color: var(--accent); flex-shrink: 0; margin-top: 2px; }

  /* Beneficio */
  .svc-benefit__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-9); align-items: center; }
  .svc-benefit__text { display: flex; flex-direction: column; gap: var(--space-5); align-items: flex-start; }

  /* Otros */
  .svc-others__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .svc-others__card { display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-7); border-radius: var(--radius-lg); background: rgba(255,255,255,0.04); border: 1px solid var(--border-dark); transition: background-color var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out); }
  .svc-others__card:hover { background: rgba(255,255,255,0.08); transform: translateY(-4px); }
  .svc-others__card h3 { color: #fff; }
  .svc-others__card p { color: var(--azul-100); }
  .svc-others__icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: var(--radius-md); background: rgba(0,172,229,0.18); color: var(--celeste-300); }

  @media (max-width: 900px) {
    .svc-hero__inner, .svc-benefit__grid { grid-template-columns: 1fr; }
    .svc-groups, .svc-others__grid { grid-template-columns: 1fr; }
    .svc-benefit__media { order: -1; max-width: 520px; }
  }
</style>
