---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import UiIcon from '../../components/UiIcon.astro';
import ContactForm from '../../components/ContactForm.astro';
import CertificacionesSection from '../../components/sections/CertificacionesSection.astro';
import { services, site } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

// Stats del hero. PLACEHOLDER: confirmar cifras reales por servicio con el cliente.
const stats = [
  { value: '300+', label: 'Servicios realizados' },
  { value: '5', label: 'En ejecución' },
];

// Beneficios (4, como el Figma). Contenido real de Relengcorp.
const benefits = [
  { title: 'Reducción de riesgos', text: 'Menos paradas no planificadas y mayor seguridad en la operación.' },
  { title: 'Mayor disponibilidad', text: 'Más vida útil y continuidad operacional de tus activos críticos.' },
  { title: 'Inteligencia aplicada', text: 'Convertimos datos de condición en decisiones accionables.' },
  { title: 'Especialistas en faena', text: 'Acompañamiento experto con experiencia comprobada en terreno.' },
];

// PLACEHOLDER: logos reales de clientes.
const clients = Array.from({ length: 6 }, (_, i) => `Cliente ${i + 1}`);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.intro,
  provider: { '@type': 'Organization', name: site.legalName, url: site.url },
  areaServed: ['PE', 'CL'],
  serviceType: service.title,
};
---

<BaseLayout title={service.title} description={service.short} schema={schema}>
  <!-- ===== HERO oscuro: captura de email + stats + imagen ===== -->
  <section class="svc-hero">
    <div class="svc-hero__bg" aria-hidden="true"><div class="svc-hero__glow"></div></div>
    <div class="container svc-hero__grid">
      <div class="svc-hero__content">
        <h1 class="h-xl" data-reveal>{service.title}</h1>
        <p class="eyebrow" data-reveal>{service.short}</p>

        <p class="svc-hero__intro text-m" data-reveal>{service.intro}</p>

        <dl class="svc-stats" data-reveal>
          {stats.map((s) => (
            <div class="svc-stat">
              <dt class="svc-stat__value">{s.value}</dt>
              <dd class="svc-stat__label text-s">{s.label}</dd>
            </div>
          ))}
        </dl>
      </div>

      <figure class="svc-hero__media zoom-img" data-reveal>
        <ImagePlaceholder label={`${service.title} en operación`} ratio="1/1" tone="dark" />
      </figure>
    </div>
  </section>

  <!-- ===== NUESTROS CLIENTES ===== -->
  <section class="section section--tight svc-clients">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <h2 class="h-m">Nuestros clientes</h2>
        <p class="text-m">
          Empresas líderes del sector minero e industrial confían en Relengcorp para maximizar
          la disponibilidad y confiabilidad de sus activos críticos.
        </p>
      </div>
      <ul class="svc-clients__logos" data-reveal>
        {clients.map((c) => <li class="svc-client-logo">{c}</li>)}
      </ul>
    </div>
  </section>

  <!-- ===== BENEFICIOS (grid 2x2) ===== -->
  <section class="section svc-benefits">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow eyebrow--center">Ventajas para tu operación</p>
        <h2 class="h-l">Beneficios que te harán estar un paso adelante</h2>
      </div>
      <div class="svc-benefits__grid">
        {benefits.map((b) => (
          <article class="svc-benefit-card" data-reveal>
            <span class="svc-benefit-card__icon"><UiIcon name="check-circle" size={24} /></span>
            <p><strong>{b.title}:</strong> {b.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== FORMULARIO DE SERVICIO + IMAGEN ===== -->
  <section class="section svc-features" id="cotiza">
    <div class="container svc-features__grid">
      <div class="svc-features__form" data-reveal>
        <ContactForm
          variant="service"
          serviceName={service.title}
          title="Solicita más información"
          description="Déjanos tus datos y un especialista te contactará. Recibirás también nuestro brochure."
          submitLabel="Enviar solicitud"
        />
      </div>
      <figure class="svc-features__media zoom-img" data-reveal>
        <ImagePlaceholder label={`${service.title} — detalle técnico`} ratio="4/5" tone="dark" />
      </figure>
    </div>
  </section>

  <!-- ===== GALERÍA: roll banner de fotografías ===== -->
  <section class="section section--tight svc-gallery" data-reveal>
    <div class="container svc-gallery__viewport">
      <div class="svc-gallery__track">
        {[1, 2, 3, 4, 5, 6, 1, 2, 3, 4, 5, 6].map((n, i) => (
          <figure class="svc-gallery__item" aria-hidden={i >= 6 ? 'true' : undefined}>
            <ImagePlaceholder label={`${service.title} — foto ${n}`} ratio="4/3" tone="dark" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CERTIFICACIONES (reutilizada del Home) ===== -->
  <CertificacionesSection />
</BaseLayout>

<style>
  /* ===== HERO claro (fondo plomo que va degradando) ===== */
  .svc-hero {
    position: relative;
    background: linear-gradient(180deg, var(--azul-50) 0%, var(--neutro-100) 55%, var(--bg-base) 100%);
    color: var(--text-body);
    padding-top: calc(var(--header-h) + var(--space-9));
    padding-bottom: var(--space-10);
    overflow: hidden;
    isolation: isolate;
  }
  .svc-hero__bg { position: absolute; inset: 0; z-index: -1; }
  .svc-hero__glow { position: absolute; top: -20%; left: -10%; width: 60%; height: 130%; background: radial-gradient(60% 60% at 30% 30%, rgba(0,172,229,0.10) 0%, transparent 70%); }
  .svc-hero__grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: var(--space-10); align-items: center; }
  .svc-hero__content { display: flex; flex-direction: column; gap: var(--space-5); max-width: 580px; }
  .svc-hero__content h1 { color: var(--text-strong); }
  .svc-hero .eyebrow { color: var(--accent); margin-top: calc(var(--space-2) * -1); }
  .svc-hero__intro { color: var(--text-body); }

  /* Stats */
  .svc-stats { display: flex; gap: var(--space-8); margin-top: var(--space-4); }
  .svc-stat { display: flex; flex-direction: column; gap: 2px; position: relative; padding-right: var(--space-8); }
  .svc-stat:not(:last-child)::after { content: ''; position: absolute; right: 0; top: 4px; bottom: 4px; width: 1px; background: var(--border); }
  .svc-stat__value { font-size: var(--fs-h-m); font-weight: var(--fw-extrabold); color: var(--accent); line-height: 1; }
  .svc-stat__label { color: var(--text-body); }

  .svc-hero__media { box-shadow: var(--shadow-5); }

  /* ===== CLIENTES ===== */
  .svc-clients__logos { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-6); margin-top: var(--space-7); }
  .svc-client-logo {
    display: grid; place-items: center;
    height: 64px; min-width: 150px; padding-inline: var(--space-6);
    border: 1px solid var(--border); border-radius: var(--radius-md);
    color: var(--neutro-300); font-weight: var(--fw-bold); letter-spacing: var(--tracking-wide);
    filter: grayscale(1);
    transition: filter var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .svc-client-logo:hover { filter: grayscale(0); color: var(--accent); box-shadow: var(--shadow-3); }

  /* ===== BENEFICIOS ===== */
  .svc-benefits__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); }
  .svc-benefit-card {
    display: flex; gap: var(--space-4); align-items: flex-start;
    padding: var(--space-7);
    border: 1px solid var(--border); border-radius: var(--radius-lg);
    background: var(--surface);
    transition: box-shadow var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
  }
  .svc-benefit-card:hover { box-shadow: var(--shadow-5); transform: translateY(-4px); border-color: transparent; }
  .svc-benefit-card__icon { color: var(--accent); flex-shrink: 0; display: inline-flex; margin-top: 2px; }
  .svc-benefit-card p { color: var(--text-body); }
  .svc-benefit-card strong { color: var(--text-strong); }

  /* ===== CARACTERÍSTICAS ===== */
  .svc-features { background: var(--bg-subtle); }
  .svc-features__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-10); align-items: center; }
  .svc-features__text { display: flex; flex-direction: column; gap: var(--space-5); align-items: flex-start; }
  .svc-features__list { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3) var(--space-5); width: 100%; }
  .svc-features__list li { display: flex; gap: var(--space-3); align-items: flex-start; color: var(--text-body); font-size: var(--fs-text-s); }
  .svc-features__list svg { color: var(--accent); flex-shrink: 0; margin-top: 2px; }
  .svc-features__media { min-height: 440px; box-shadow: var(--shadow-4); }
  .svc-features__media :global(.ph) { height: 100%; }

  /* ===== GALERÍA: roll banner ===== */
  .svc-gallery__viewport {
    overflow: hidden;
  }
  .svc-gallery__track {
    display: flex;
    gap: var(--space-6);
    width: max-content;
    padding-block: var(--space-6);
    margin-block: calc(var(--space-6) * -1);
    animation: svc-gallery-scroll 45s linear infinite;
  }
  .svc-gallery__track:hover { animation-play-state: paused; }
  .svc-gallery__item {
    flex: 0 0 340px;
    margin: 0;
  }
  .svc-gallery__item :global(.ph) {
    position: relative;
    box-shadow: var(--shadow-3);
    transition: box-shadow var(--dur-base) var(--ease-out);
  }
  .svc-gallery__item :global(.ph)::before {
    content: '';
    position: absolute;
    inset: 0;
    background: inherit;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .svc-gallery__item:hover {
    z-index: 1;
  }
  .svc-gallery__item:hover :global(.ph) {
    box-shadow: var(--shadow-5);
  }
  .svc-gallery__item:hover :global(.ph)::before {
    transform: scale(1.1);
  }
  @keyframes svc-gallery-scroll {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .svc-gallery__track { animation: none; }
  }
  @media (max-width: 620px) {
    .svc-gallery__item { flex: 0 0 260px; }
  }

  /* ===== Responsive ===== */
  @media (max-width: 900px) {
    .svc-hero__grid, .svc-features__grid { grid-template-columns: 1fr; }
    .svc-hero__media { order: -1; max-width: 460px; }
    .svc-benefits__grid { grid-template-columns: 1fr; }
    .svc-features__media { order: -1; min-height: 320px; }
  }
  @media (max-width: 620px) {
    .svc-features__list { grid-template-columns: 1fr; }
    .svc-gallery__grid { grid-template-columns: 1fr; }
    .svc-stats { gap: var(--space-6); }
  }
</style>
