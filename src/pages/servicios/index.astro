---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { services } from '../../data/site';
---
<BaseLayout
  title="Servicios Especializados"
  description="Soluciones integrales de confiabilidad: integridad estructural, mantenimiento predictivo, ingeniería de confiabilidad, metalurgia, confiabilidad inteligente, ingeniería digital y gestión de reparables críticos."
>
  <PageHeader
    eyebrow="Servicios especializados"
    title="Aseguramos disponibilidad y confiabilidad de tus activos críticos"
    subtitle="Anticipamos, conectamos y optimizamos operaciones críticas mediante inteligencia aplicada. Conoce nuestras siete líneas de servicio para la industria minera e industrial."
    breadcrumbs={[{ label: 'Servicios' }]}
  />

  <section class="section">
    <div class="container">
      <div class="services-grid">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <section class="section section-dark services-cta on-dark">
    <div class="container services-cta__inner">
      <div data-reveal>
        <h2 class="h-l">¿No sabes qué servicio necesitas?</h2>
        <p class="text-m">Cuéntanos sobre tu operación y diseñamos la solución de confiabilidad a tu medida.</p>
      </div>
      <a href="/contacto" class="btn btn--lg" data-reveal>Habla con un especialista</a>
    </div>
  </section>
</BaseLayout>

<style>
  .services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-7); }
  @media (max-width: 900px) { .services-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .services-grid { grid-template-columns: 1fr; } }

  .services-cta__inner { display: flex; justify-content: space-between; align-items: center; gap: var(--space-8); flex-wrap: wrap; }
  .services-cta__inner h2 { color: #fff; }
  .services-cta__inner p { color: var(--azul-100); margin-top: var(--space-3); max-width: 52ch; }
</style>
