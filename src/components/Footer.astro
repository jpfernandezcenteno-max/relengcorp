---
/* ============================================================
   FOOTER — fondo oscuro con datos de contacto, oficinas y navegación.
   ============================================================ */
import { site, social, offices, services, certifications } from '../data/site';
import logoSvg from '../../public/logo.svg?raw';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <!-- Marca -->
    <div class="site-footer__brand">
      <a href="/" class="site-footer__logo" aria-label={`${site.name} — inicio`}>
        <Fragment set:html={logoSvg} />
      </a>
      <p class="site-footer__desc">
        Soluciones integrales de confiabilidad, mantenimiento predictivo y transformación
        digital para la industria minera e industrial.
      </p>
      <ul class="site-footer__certs" aria-label="Certificaciones">
        {certifications.map((c) => (
          <li><img src={c.logo} alt={`Certificación ${c.code}`} loading="lazy" decoding="async" /></li>
        ))}
      </ul>
      <ul class="site-footer__social" aria-label="Redes sociales">
        <li>
          <a href={social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.41c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.45 2.91h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94z"/></svg>
          </a>
        </li>
        <li>
          <a href={social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 2c-2.72 0-3.06.01-4.12.06-1.06.05-1.79.22-2.43.47-.66.26-1.22.6-1.76 1.14a4.89 4.89 0 0 0-1.14 1.76c-.25.64-.42 1.37-.47 2.43C2.01 8.94 2 9.28 2 12c0 2.72.01 3.06.06 4.12.05 1.06.22 1.79.47 2.43.26.66.6 1.22 1.14 1.76.54.54 1.1.88 1.76 1.14.64.25 1.37.42 2.43.47C8.94 21.99 9.28 22 12 22c2.72 0 3.06-.01 4.12-.06 1.06-.05 1.79-.22 2.43-.47a4.89 4.89 0 0 0 1.76-1.14 4.89 4.89 0 0 0 1.14-1.76c.25-.64.42-1.37.47-2.43.05-1.06.06-1.4.06-4.12 0-2.72-.01-3.06-.06-4.12-.05-1.06-.22-1.79-.47-2.43a4.89 4.89 0 0 0-1.14-1.76 4.89 4.89 0 0 0-1.76-1.14c-.64-.25-1.37-.42-2.43-.47C15.06 2.01 14.72 2 12 2zm0 1.8c2.67 0 2.99.01 4.04.06.98.04 1.5.21 1.85.34.46.18.79.4 1.14.74.34.35.56.68.74 1.14.13.36.3.88.34 1.85.05 1.05.06 1.37.06 4.04 0 2.67-.01 2.99-.06 4.04-.04.98-.21 1.5-.34 1.85-.18.46-.4.79-.74 1.14-.35.34-.68.56-1.14.74-.36.13-.88.3-1.85.34-1.05.05-1.37.06-4.04.06-2.67 0-2.99-.01-4.04-.06-.98-.04-1.5-.21-1.85-.34a3.09 3.09 0 0 1-1.14-.74 3.09 3.09 0 0 1-.74-1.14c-.13-.36-.3-.88-.34-1.85-.05-1.05-.06-1.37-.06-4.04 0-2.67.01-2.99.06-4.04.04-.98.21-1.5.34-1.85.18-.46.4-.79.74-1.14.35-.34.68-.56 1.14-.74.36-.13.88-.3 1.85-.34 1.05-.05 1.37-.06 4.04-.06zm0 3.07a5.13 5.13 0 1 0 0 10.26 5.13 5.13 0 0 0 0-10.26zm0 8.46a3.33 3.33 0 1 1 0-6.66 3.33 3.33 0 0 1 0 6.66zm6.54-8.66a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0z"/></svg>
          </a>
        </li>
        <li>
          <a href={social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.28 2.38 4.28 5.47v6.27zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
          </a>
        </li>
        <li>
          <a href={social.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.54 3.5 12 3.5 12 3.5s-7.54 0-9.38.55A3.02 3.02 0 0 0 .5 6.19C0 8.04 0 12 0 12s0 3.96.5 5.81a3.02 3.02 0 0 0 2.12 2.14C4.46 20.5 12 20.5 12 20.5s7.54 0 9.38-.55a3.02 3.02 0 0 0 2.12-2.14C24 15.96 24 12 24 12s0-3.96-.5-5.81zM9.75 15.5v-7l6.5 3.5-6.5 3.5z"/></svg>
          </a>
        </li>
      </ul>
    </div>

    <!-- Servicios -->
    <details class="site-footer__col footer-accordion" open>
      <summary class="site-footer__title">Servicios</summary>
      <ul>
        {services.map((s) => (
          <li><a href={`/servicios/${s.slug}`}>{s.title}</a></li>
        ))}
      </ul>
    </details>

    <!-- Empresa -->
    <details class="site-footer__col footer-accordion" open>
      <summary class="site-footer__title">Empresa</summary>
      <ul>
        <li><a href="/nosotros">Nosotros</a></li>
        <li><a href="/portafolio">Portafolio</a></li>
        <li><a href="/clientes">Clientes</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/trabaja-con-nosotros">Trabaja con nosotros</a></li>
        <li><a href="/contacto">Contáctanos</a></li>
      </ul>
    </details>

    <!-- Contacto -->
    <details class="site-footer__col site-footer__contact footer-accordion" open>
      <summary class="site-footer__title">Contacto</summary>
      <ul>
        <li>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <a href={`tel:${site.phoneRaw}`}>{site.phone}</a>
        </li>
      </ul>
      <ul class="site-footer__offices">
        {offices.map((o) => (
          <li>
            <strong>{o.label}</strong>
            <span>{o.address}</span>
          </li>
        ))}
      </ul>
    </details>
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {year} {site.legalName}. Todos los derechos reservados.</p>
    <nav class="site-footer__legal" aria-label="Políticas">
      <a href="/politica-de-privacidad">Política de Privacidad y Protección de Datos</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--gradient-hero);
    color: var(--azul-100);
    padding-top: var(--space-14);
    font-size: var(--fs-text-s);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.4fr;
    gap: var(--space-9) var(--space-7);
    padding-bottom: var(--space-10);
  }
  .site-footer__logo { color: #fff; display: inline-flex; margin-bottom: var(--space-5); }
  .site-footer__logo :global(svg) { display: block; height: 40px; width: auto; }
  .site-footer__desc { max-width: 36ch; line-height: var(--lh-body); }
  .site-footer__certs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .site-footer__certs li {
    display: grid;
    place-items: center;
    padding: 6px 10px;
    border-radius: var(--radius-md);
    background: #fff;
  }
  .site-footer__certs li img { display: block; height: 46px; width: auto; }

  .site-footer__social {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .site-footer__social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--border-dark);
    border-radius: 50%;
    color: var(--azul-100);
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .site-footer__social a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .site-footer__title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    color: #fff;
    font-size: var(--fs-text-r);
    font-weight: var(--fw-bold);
    margin-bottom: var(--space-5);
    list-style: none;
  }
  .site-footer__title::-webkit-details-marker { display: none; }
  .site-footer__title::after {
    content: '';
    display: none;
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .footer-accordion[open] > .site-footer__title::after { transform: rotate(-135deg); }
  .site-footer__col ul { display: flex; flex-direction: column; gap: var(--space-4); }
  .site-footer__col a,
  .site-footer__contact a {
    color: var(--azul-100);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .site-footer__col a:hover,
  .site-footer__contact a:hover { color: var(--accent); }

  .site-footer__offices { margin-top: var(--space-6); gap: var(--space-5); }
  .site-footer__offices li { display: flex; flex-direction: column; gap: 2px; }
  .site-footer__offices strong { color: #fff; font-weight: var(--fw-semibold); }
  .site-footer__offices span { color: var(--azul-200); line-height: var(--lh-snug); }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-block: var(--space-6);
    margin-top: var(--space-6);
    border-top: 1px solid var(--border-dark);
    color: var(--azul-200);
    font-size: var(--fs-text-xs);
  }
  .site-footer__legal a {
    color: var(--azul-200);
    font-size: var(--fs-text-xs);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .site-footer__legal a:hover { color: var(--accent); }

  @media (max-width: 980px) {
    .site-footer__grid { grid-template-columns: 1fr 1fr; }
    .site-footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 760px) {
    .site-footer__grid { grid-template-columns: 1fr; gap: 0; padding-bottom: var(--space-6); }
    .site-footer__brand { padding-bottom: var(--space-8); }
    .site-footer__bottom { justify-content: center; text-align: center; flex-direction: column; align-items: center; }
    .site-footer__legal { text-align: center; }

    /* Servicios, Empresa y Contacto se vuelven acordeones para ocupar menos espacio */
    .footer-accordion {
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      padding-block: var(--space-5);
    }
    .footer-accordion .site-footer__title {
      margin-bottom: 0;
      cursor: pointer;
    }
    .footer-accordion .site-footer__title::after { display: block; }
    .footer-accordion[open] .site-footer__title { margin-bottom: var(--space-5); }
  }
</style>

<script>
  // En responsive, Servicios/Empresa/Contacto inician colapsados (dropdown);
  // en escritorio siempre permanecen expandidos.
  const accordions = document.querySelectorAll<HTMLDetailsElement>('.footer-accordion');
  const mq = window.matchMedia('(max-width: 760px)');
  const syncAccordions = () => {
    accordions.forEach((details) => {
      details.open = !mq.matches;
    });
  };
  syncAccordions();
  mq.addEventListener('change', syncAccordions);
</script>
