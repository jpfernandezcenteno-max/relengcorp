---
/* ============================================================
   PAGE HEADER — encabezado de páginas internas.
   Fondo oscuro industrial + breadcrumb + título. Consistente
   con la identidad del Home.
   ============================================================ */
interface Crumb { label: string; href?: string; }
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  breadcrumbs?: Crumb[];
}
const { eyebrow, title, subtitle, breadcrumbs = [] } = Astro.props;
---
<header class="page-header">
  <div class="page-header__bg" aria-hidden="true">
    <div class="page-header__glow"></div>
  </div>
  <div class="container page-header__inner">
    {breadcrumbs.length > 0 && (
      <nav class="breadcrumb" aria-label="Ruta de navegación">
        <ol>
          <li><a href="/">Inicio</a></li>
          {breadcrumbs.map((c) => (
            <li>
              {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
    <h1 class="page-header__title h-xl" data-reveal>{title}</h1>
    {subtitle && <p class="page-header__sub text-l" data-reveal>{subtitle}</p>}
  </div>
</header>

<style>
  .page-header {
    position: relative;
    background: var(--gradient-hero);
    color: var(--text-on-dark);
    padding-top: calc(var(--header-h) + var(--space-10));
    padding-bottom: var(--space-10);
    overflow: hidden;
    isolation: isolate;
  }
  .page-header__bg { position: absolute; inset: 0; z-index: -1; }
  .page-header__glow {
    position: absolute;
    top: -30%;
    right: -10%;
    width: 50%;
    height: 140%;
    background: var(--gradient-glow);
  }
  .page-header__inner { display: flex; flex-direction: column; gap: var(--space-5); max-width: 820px; }
  .page-header .eyebrow { color: var(--celeste-300); }
  .page-header__title { color: #fff; }
  .page-header__sub { color: var(--azul-100); max-width: 62ch; }

  .breadcrumb ol { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; }
  .breadcrumb li { display: flex; align-items: center; gap: var(--space-3); font-size: var(--fs-text-s); color: var(--azul-200); }
  .breadcrumb li + li::before { content: '/'; color: var(--azul-300); }
  .breadcrumb a { color: var(--azul-100); transition: color var(--dur-fast) var(--ease-out); }
  .breadcrumb a:hover { color: var(--celeste-300); }
  .breadcrumb [aria-current] { color: #fff; }
</style>
