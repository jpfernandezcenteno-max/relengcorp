---
/* ============================================================
   PAGE HEADER — encabezado de páginas internas.
   Fondo oscuro industrial + título + imagen. Consistente
   con la identidad del Home.
   ============================================================ */
import ImagePlaceholder from './ImagePlaceholder.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  /** Descripción de la imagen sugerida junto al título */
  imageLabel?: string;
  /** 'light' (por defecto, fondo claro) o 'dark' */
  tone?: 'dark' | 'light';
}
const { eyebrow, title, subtitle, imageLabel = 'Imagen representativa', tone = 'light' } = Astro.props;
---
<header class:list={['page-header', `page-header--${tone}`]}>
  <div class="page-header__bg" aria-hidden="true">
    <div class="page-header__glow"></div>
  </div>
  <div class="container page-header__inner">
    <div class="page-header__content">
      {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
      <h1 class="page-header__title h-xl" data-reveal>{title}</h1>
      {subtitle && <p class="page-header__sub text-l" data-reveal>{subtitle}</p>}
    </div>
    <div class="page-header__figure" data-reveal>
      <ImagePlaceholder label={imageLabel} ratio="4/3" tone={tone === 'dark' ? 'dark' : 'light'} />
    </div>
  </div>
</header>

<style>
  .page-header {
    position: relative;
    background: var(--gradient-hero);
    color: var(--text-on-dark);
    padding-top: calc(var(--header-h) + var(--space-10));
    padding-bottom: var(--space-14);
    overflow: hidden;
    isolation: isolate;
  }
  .page-header__bg { position: absolute; inset: 0; z-index: -1; }
  .page-header__glow {
    position: absolute;
    top: -30%;
    right: -10%;
    width: 50%;
    height: 140%;
    background: var(--gradient-glow);
  }
  .page-header__inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: var(--space-10);
  }
  .page-header__content { display: flex; flex-direction: column; gap: var(--space-5); }
  .page-header .eyebrow { color: var(--celeste-300); }
  .page-header__title { color: #fff; }
  .page-header__sub { color: var(--azul-100); max-width: 62ch; }
  .page-header__figure { width: 100%; }
  :global(.page-header__figure .ph) { box-shadow: var(--shadow-6); }

  /* ---- Variante clara (fondo blanco) ---- */
  .page-header--light {
    background: var(--bg-base);
    color: var(--text-body);
    border-bottom: 1px solid var(--border);
  }
  .page-header--light .page-header__glow {
    background: radial-gradient(60% 60% at 80% 20%, rgba(0, 172, 229, 0.10) 0%, transparent 70%);
  }
  .page-header--light .eyebrow { color: var(--accent); }
  .page-header--light .page-header__title { color: var(--text-strong); }
  .page-header--light .page-header__sub { color: var(--text-body); }

  /* ---- Responsive ---- */
  @media (max-width: 980px) {
    .page-header__inner { grid-template-columns: 1fr; gap: var(--space-7); }
    .page-header__figure { order: -1; max-width: 420px; }
  }
</style>
