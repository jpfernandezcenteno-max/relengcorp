---
/* Botón flotante de WhatsApp (presente en todo el sitio, como en Figma). */
import { site } from '../data/site';
const waLink = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(
  'Hola Relengcorp, me gustaría más información sobre sus servicios.'
)}`;
---

<a
  class="wa-fab"
  href={waLink}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escríbenos por WhatsApp"
>
  <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor" aria-hidden="true">
    <path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.519 5.26l-.999 3.648 3.748-.997zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.71.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
  </svg>
</a>

<style>
  .wa-fab {
    position: fixed;
    right: clamp(16px, 3vw, 28px);
    bottom: clamp(16px, 3vw, 28px);
    z-index: var(--z-overlay);
    width: 60px;
    height: 60px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--whatsapp);
    color: #fff;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.45);
    transition: transform var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .wa-fab::after {
    /* halo pulsante para captar la atención (con propósito: canal de contacto directo) */
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--whatsapp);
    opacity: 0.55;
    z-index: -1;
    animation: wa-pulse 2.4s var(--ease-out) infinite;
  }
  .wa-fab:hover {
    transform: scale(1.08);
    background: var(--whatsapp-hover);
  }
  @keyframes wa-pulse {
    0% { transform: scale(1); opacity: 0.55; }
    70% { transform: scale(1.7); opacity: 0; }
    100% { transform: scale(1.7); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-fab::after { animation: none; display: none; }
  }
</style>
