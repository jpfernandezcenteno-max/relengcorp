---
/* SECCIÓN SHOWCASE DE SERVICIOS — grilla visual imagen + título + mensaje (Home). */
import ImagePlaceholder from '../ImagePlaceholder.astro';
import { services } from '../../data/site';
---

<section class="section section--tight svc-showcase" aria-labelledby="svc-showcase-title">
  <div class="container">

    <div class="section-head section-head--center" data-reveal>
      <p class="eyebrow">Nuestros servicios</p>
      <h2 id="svc-showcase-title" class="h-l">Cobertura integral para tu operación</h2>
      <p class="text-m">
        Más de ingeniería. Más que mantenimiento. Integramos confiabilidad, inteligencia
        artificial y tecnologías digitales para optimizar el desempeño de activos críticos.
      </p>
    </div>

    <ul class="svc-showcase__grid">
      {services.map((s) => (
        <li class="svc-showcase__item" data-reveal>
          <a href={`/servicios/${s.slug}`} class="svc-showcase__card">

            <div class="svc-showcase__media">
              <ImagePlaceholder label={s.title} ratio="4/3" tone="dark" />
              <div class="svc-showcase__overlay">
                <ul class="svc-showcase__subs">
                  {s.subservices.slice(0, 5).map((sub) => (
                    <li>
                      <span class="svc-showcase__sub-name">{sub.name}</span>
                      <span class="svc-showcase__sub-slogan">{sub.slogan}</span>
                    </li>
                  ))}
                  {s.subservices.length > 5 && (
                    <li class="svc-showcase__more">+{s.subservices.length - 5} más</li>
                  )}
                </ul>
              </div>
            </div>

            <div class="svc-showcase__body">
              <h3 class="svc-showcase__title">{s.title}</h3>
              <p class="svc-showcase__message">{s.message}</p>
            </div>

          </a>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .svc-showcase { background: var(--bg-base); }

  .svc-showcase__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
    margin-top: var(--space-10);
  }

  .svc-showcase__item:nth-last-child(-n+3):first-child,
  .svc-showcase__item:nth-last-child(-n+3):first-child ~ .svc-showcase__item {
    grid-column: auto;
  }

  .svc-showcase__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    transition: transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .svc-showcase__card:hover,
  .svc-showcase__card:focus-visible {
    transform: translateY(-5px);
    box-shadow: var(--shadow-5);
    outline: none;
  }
  .svc-showcase__card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* ---- Imagen + overlay con sub-servicios ---- */
  .svc-showcase__media {
    position: relative;
    flex-shrink: 0;
    overflow: hidden;
  }
  .svc-showcase__media :global(.ph) { border-radius: 0; display: block; }

  .svc-showcase__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: var(--space-4);
    background: linear-gradient(to top, rgba(28,29,45,0.96) 0%, rgba(28,29,45,0.5) 60%, transparent 100%);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
    overflow: hidden;
  }
  .svc-showcase__card:hover .svc-showcase__overlay,
  .svc-showcase__card:focus-visible .svc-showcase__overlay { opacity: 1; }

  .svc-showcase__subs {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
  }
  .svc-showcase__subs li {
    display: flex;
    flex-direction: column;
    gap: 1px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: 6px;
  }
  .svc-showcase__subs li:last-child { border-bottom: none; padding-bottom: 0; }

  .svc-showcase__sub-name {
    font-size: var(--fs-text-xs);
    font-weight: var(--fw-semibold);
    color: #fff;
    line-height: 1.3;
  }
  .svc-showcase__sub-slogan {
    font-size: 10px;
    color: var(--celeste-300);
    line-height: 1.3;
  }
  .svc-showcase__more {
    font-size: var(--fs-text-xs);
    color: rgba(255,255,255,0.5);
    font-style: italic;
    border-bottom: none !important;
  }

  /* ---- Cuerpo de la card ---- */
  .svc-showcase__body {
    padding: var(--space-5) var(--space-5) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .svc-showcase__title {
    font-size: var(--fs-h-xs);
    font-weight: var(--fw-semibold);
    color: var(--text-strong);
    line-height: var(--lh-snug);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .svc-showcase__card:hover .svc-showcase__title { color: var(--accent); }

  .svc-showcase__message {
    font-size: var(--fs-text-s);
    color: var(--text-muted);
    line-height: var(--lh-body);
  }

  /* ---- Responsive ---- */
  @media (max-width: 1100px) {
    .svc-showcase__grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 720px) {
    .svc-showcase__grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-4); }
  }
  @media (max-width: 420px) {
    .svc-showcase__grid { grid-template-columns: 1fr; }
  }
</style>
