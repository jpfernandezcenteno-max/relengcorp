---
/* SECCIÓN CLIENTES — banner marquee infinito con logos (Home).
   Se mezclan aleatoriamente en cada build para variar el orden. */

const clientSlugs = [
  'altonorte', 'antamina', 'antapaccay', 'bechtel', 'capstone', 'chinalco', 'codelco',
  'grupo-mexico-southern', 'hudbay', 'las-bambas', 'lomas-bayas', 'marcobre', 'minera-ares',
  'newmont', 'nexa', 'nirsa', 'ocp-cobriza', 'panamerican', 'pelambres', 'teck', 'tintaya', 'volcan',
];
const nameFor = (s: string) => ({
  'grupo-mexico-southern': 'Grupo México Southern',
  'ocp-cobriza':           'OCP Cobriza',
  'minera-ares':           'Minera Ares',
  'las-bambas':            'Las Bambas',
  'lomas-bayas':           'Lomas Bayas',
}[s] ?? s.charAt(0).toUpperCase() + s.slice(1));

// Shuffle aleatorio en cada build
const shuffled = [...clientSlugs].sort(() => Math.random() - 0.5);
const clients = shuffled.map((s) => ({ name: nameFor(s), logo: `/images/clientes/${s}.png` }));
---

<section class="section section--tight clientes-home" aria-labelledby="clientes-home-title">
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <p class="eyebrow eyebrow--center">Con quienes trabajamos</p>
      <h2 id="clientes-home-title" class="h-l">Empresas que confían en Relengcorp</h2>
    </div>
  </div>

  <!-- Marquee: duplicado para loop continuo -->
  <div class="clientes-marquee" data-reveal>
    <div class="clientes-track" aria-hidden="false">
      {[...clients, ...clients].map((c, i) => (
        <div class="clientes-item" aria-hidden={i >= clients.length ? 'true' : undefined}>
          <img src={c.logo} alt={c.name} loading="lazy" decoding="async" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .clientes-home { background: var(--bg-subtle); }
  .clientes-home .section-head { margin-bottom: var(--space-9); }

  .clientes-marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent 0%, black 8%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, black 8%, black 92%, transparent 100%);
  }

  .clientes-track {
    display: flex;
    gap: var(--space-5);
    width: max-content;
    padding-block: var(--space-4);
    animation: clientes-scroll 40s linear infinite;
  }
  .clientes-track:hover { animation-play-state: paused; }

  .clientes-item {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 160px;
    height: 80px;
    padding: var(--space-3) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: box-shadow var(--dur-base) var(--ease-out);
  }
  .clientes-item:hover { box-shadow: var(--shadow-3); }

  .clientes-item img {
    max-height: 38px;
    max-width: 110px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(1) opacity(0.7);
    transition: filter var(--dur-base) var(--ease-out), opacity var(--dur-base) var(--ease-out);
  }
  .clientes-item:hover img { filter: grayscale(0) opacity(1); }

  @keyframes clientes-scroll {
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .clientes-track { animation: none; }
  }
</style>
