---
/* SECCIÓN SOCIOS ESTRATÉGICOS — card oscura sobre fondo blanco (Home).
   Imagen a la izquierda + texto y botones a la derecha. */
import ImagePlaceholder from '../ImagePlaceholder.astro';
const brochureUrl = '/brochures/relengcorp-brochure.pdf';
---
<section class="section socios">
  <div class="container">
    <div class="socios__card">
      <figure class="socios__media zoom-img" data-reveal>
        <ImagePlaceholder label="Operación minera / planta" ratio="16/10" tone="dark" />
      </figure>
      <div class="socios__content">
        <h2 class="h-l socios__title" data-reveal>
          Socios Estratégicos <span class="text-accent">en tus operaciones</span>
        </h2>
        <p class="text-m socios__desc" data-reveal>
          Ser reconocidos por nuestros clientes como un socio estratégico, brindando servicios
          cuyos resultados generen beneficios concretos, medibles y sostenibles para su
          productividad y crecimiento operativo.
        </p>
        <div class="socios__actions" data-reveal>
          <a href="/contacto" class="btn" data-gtm-id="socios-cta-contacto">Contáctate aquí</a>
          <a href={brochureUrl} download class="btn btn--outline-light" data-gtm-id="socios-cta-brochure">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Descargar brochure
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .socios { background: var(--bg-base); }
  .socios__card {
    position: relative;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-9);
    align-items: center;
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    /* Fondo puro azul-900 + glow celeste centrado en el área de contenido (Figma) */
    background:
      radial-gradient(55% 75% at 75% 50%, rgba(0, 172, 229, 0.38) 0%, transparent 70%),
      var(--azul-900);
    border: 1px solid var(--border-dark);
    box-shadow: var(--shadow-5);
    overflow: hidden;
  }
  /* Grilla de cuadros decorativa que se desvanece hacia la izquierda */
  .socios__card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.12) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse 52% 85% at 68% 50%, black 0%, rgba(0,0,0,0.6) 45%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 52% 85% at 68% 50%, black 0%, rgba(0,0,0,0.6) 45%, transparent 100%);
  }
  .socios__media { position: relative; z-index: 1; box-shadow: var(--shadow-4); border: 1px solid var(--morado-500); border-radius: var(--radius-lg); }
  .socios__content { position: relative; z-index: 1; display: flex; flex-direction: column; gap: var(--space-5); align-items: flex-start; }
  .socios__title { color: #fff; }
  .socios__desc { color: var(--azul-100); }
  .socios__actions { display: flex; flex-wrap: wrap; gap: var(--space-4); }

  @media (max-width: 860px) {
    .socios__card { grid-template-columns: 1fr; padding: var(--space-6); }
    .socios__media { order: -1; }
  }
</style>
