---
/* SECCIÓN CERTIFICACIONES — Trinorma ISO (Home). Card destacada (acento morado, como Figma). */
import { certifications, homologations } from '../../data/site';
---
<section class="section certs" aria-labelledby="certs-title">
  <div class="container">
    <div class="certs__panel">
      <div class="certs__intro" data-reveal>
        <p class="eyebrow">Estándares internacionales</p>
        <h2 id="certs-title" class="h-l">Estamos certificados</h2>
        <p class="text-m certs__lead">
          Nuestras operaciones se desarrollan bajo estándares internacionales de calidad,
          seguridad y mejora continua, alineados a normas ISO que garantizan confiabilidad y
          excelencia operativa en cada proyecto.
        </p>
      </div>

      <ul class="certs__grid">
        {certifications.map((c) => (
          <li class="certs__item" data-reveal>
            <span class="certs__logo"><img src={c.logo} alt={`Certificación ${c.code}`} loading="lazy" decoding="async" /></span>
          </li>
        ))}
      </ul>

      <div class="certs__homolog" data-reveal>
        <span class="certs__homolog-label">Empresa homologada por:</span>
        <ul>
          {homologations.map((h) => (
            <li><img class="certs__homolog-logo" src={h.logo} alt={h.name} loading="lazy" decoding="async" /></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .certs__panel {
    position: relative;
    border-radius: var(--radius-xl);
    padding: var(--space-12);
    color: #fff;
    background: var(--gradient-hero);
    overflow: hidden;
    isolation: isolate;
  }
  .certs__panel h2 { color: #fff; }
  .certs__intro { max-width: 620px; display: flex; flex-direction: column; gap: var(--space-4); }
  .certs__intro .eyebrow { color: var(--morado-200); }
  .certs__lead { color: rgba(255,255,255,0.85); }

  .certs__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-9);
  }
  .certs__item {
    display: grid;
    place-items: center;
    padding: var(--space-5) var(--space-4);
  }
  .certs__logo { display: grid; place-items: center; width: 190px; height: 84px; }
  .certs__logo img {
    max-width: 100%; max-height: 100%; object-fit: contain;
    filter: brightness(0) invert(1); /* logo en blanco sobre el panel oscuro */
  }

  .certs__homolog {
    margin-top: var(--space-9);
    padding-top: var(--space-7);
    border-top: 1px solid rgba(255,255,255,0.14);
  }
  .certs__homolog-label {
    display: block; text-align: center;
    color: rgba(255,255,255,0.7); font-size: var(--fs-text-s);
    margin-bottom: var(--space-6);
  }
  .certs__homolog ul {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6); align-items: center; justify-items: center;
  }
  .certs__homolog li { display: flex; justify-content: center; }
  .certs__homolog-logo {
    display: block; height: 84px; width: auto; max-width: 100%;
    padding: 10px 16px; border-radius: var(--radius-md);
    background: #fff;
  }

  @media (max-width: 900px) {
    .certs__grid, .certs__homolog ul { grid-template-columns: 1fr; }
  }
  @media (max-width: 744px) { .certs__panel { padding: var(--space-8) var(--space-6); } }
</style>
