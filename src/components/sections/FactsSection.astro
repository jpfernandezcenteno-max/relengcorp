---
/* SECCIÓN DATOS QUE RESPALDAN — fiel al Figma: fondo oscuro con degradados
   radiales, números con degradado y layout 3 + 2 con divisores. */
const row1 = [
  { value: 20, suffix: '+', label: 'Clientes en minería e industria' },
  { value: 300, suffix: '+', label: 'Proyectos ejecutados' },
  { value: 95, suffix: '%', label: 'Índice de satisfacción del cliente' },
];
const row2 = [
  { value: 10, suffix: '+', label: 'Años de experiencia' },
  { value: 60, suffix: '+', label: 'Trabajadores capacitados' },
];
---
<section class="facts" aria-labelledby="facts-title" data-facts>
  <div class="container">
    <h2 id="facts-title" class="h-m facts__title" data-reveal>Datos que respaldan</h2>

    <dl class="facts__row facts__row--3">
      {row1.map((f) => (
        <div class="facts__item" data-reveal>
          <dt class="facts__value"><span data-counter data-target={f.value}>0</span>{f.suffix}</dt>
          <dd class="facts__label text-s">{f.label}</dd>
        </div>
      ))}
    </dl>

    <dl class="facts__row facts__row--2">
      {row2.map((f) => (
        <div class="facts__item" data-reveal>
          <dt class="facts__value"><span data-counter data-target={f.value}>0</span>{f.suffix}</dt>
          <dd class="facts__label text-s">{f.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .facts {
    position: relative;
    padding-block: var(--space-14);
    color: #fff;
    background:
      radial-gradient(38% 55% at 2% 0%, rgba(137, 95, 226, 0.28) 0%, transparent 70%),
      radial-gradient(36% 50% at 100% 2%, rgba(0, 172, 229, 0.22) 0%, transparent 70%),
      radial-gradient(45% 60% at 100% 100%, rgba(66, 70, 106, 0.45) 0%, transparent 70%),
      radial-gradient(40% 60% at 0% 100%, rgba(0, 172, 229, 0.12) 0%, transparent 70%),
      #0a0b14;
    overflow: hidden;
    isolation: isolate;
  }
  .facts__title { text-align: center; color: #fff; margin-bottom: var(--space-10); }

  .facts__row { display: grid; }
  .facts__row--3 { grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid rgba(255, 255, 255, 0.12); }
  .facts__row--2 { grid-template-columns: repeat(2, 1fr); max-width: 66.66%; margin-inline: auto; }

  .facts__item {
    text-align: center;
    padding: var(--space-8) var(--space-5);
    border-right: 1px solid rgba(255, 255, 255, 0.12);
  }
  .facts__row--3 .facts__item:last-child,
  .facts__row--2 .facts__item:last-child { border-right: none; }

  .facts__value {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 3.25rem);
    font-weight: var(--fw-bold);
    line-height: 1;
    background: linear-gradient(160deg, #ffffff 0%, var(--celeste-300) 45%, var(--morado-400) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .facts__label { color: var(--azul-100); margin-top: var(--space-4); }

  @media (max-width: 760px) {
    .facts__row--3 { grid-template-columns: 1fr; }
    .facts__row--2 { grid-template-columns: 1fr; max-width: 100%; }
    .facts__item { border-right: none; border-bottom: 1px solid rgba(255, 255, 255, 0.12); }
    .facts__row--2 .facts__item:last-child { border-bottom: none; }
  }
</style>

<script>
  // Contador animado al entrar en viewport (respeta prefers-reduced-motion).
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const section = document.querySelector<HTMLElement>('[data-facts]');
  if (section) {
    const counters = section.querySelectorAll<HTMLElement>('[data-counter]');
    const run = () => {
      counters.forEach((c) => {
        const target = Number(c.dataset.target || '0');
        if (reduce) { c.textContent = String(target); return; }
        const duration = 1600;
        const start = performance.now();
        const step = (now: number) => {
          const p = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          c.textContent = String(Math.round(target * eased));
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
    };
    const io = new IntersectionObserver(
      (entries, obs) => entries.forEach((e) => { if (e.isIntersecting) { run(); obs.disconnect(); } }),
      { threshold: 0.4 }
    );
    io.observe(section);
  }
</script>
