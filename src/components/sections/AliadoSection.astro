---
/* SECCIÓN ALIADO CONFIABLE — fondo blanco, centrado, con logos de clientes (Home). */

// PLACEHOLDER: reemplazar por logos reales de clientes.
const clients = Array.from({ length: 8 }, (_, i) => `Cliente ${i + 1}`);
---
<section class="section aliado">
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <p class="eyebrow eyebrow--center">La nueva generación de la confiabilidad industrial</p>
      <h2 class="h-xl aliado__title">Aliado confiable para distintas industrias.</h2>
    </div>

    <div class="aliado__cta" data-reveal>
      <a href="/portafolio" class="btn btn--lg" data-gtm-id="aliado-cta-portafolio">Visitar portafolio</a>
    </div>

    <div class="aliado__clients" data-reveal>
      <p class="aliado__clients-label text-s">Conoce algunos de nuestros clientes:</p>
      <ul class="aliado__logos">
        {clients.map((c) => <li class="aliado__logo">{c}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .aliado { background: var(--bg-base); }
  .aliado__title { color: var(--text-strong); }
  .aliado__cta { display: flex; justify-content: center; margin-bottom: var(--space-10); }

  .aliado__clients { display: flex; flex-direction: column; align-items: center; gap: var(--space-7); }
  .aliado__clients-label { color: var(--text-muted); }
  .aliado__logos {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-7) var(--space-9);
    width: 100%;
    max-width: 880px;
  }
  .aliado__logo {
    display: grid; place-items: center;
    height: 56px;
    color: var(--neutro-300);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-wide);
    filter: grayscale(1);
    transition: filter var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }
  .aliado__logo:hover { filter: grayscale(0); color: var(--accent); transform: translateY(-3px); }

  @media (max-width: 760px) { .aliado__logos { grid-template-columns: repeat(2, 1fr); } }
</style>
