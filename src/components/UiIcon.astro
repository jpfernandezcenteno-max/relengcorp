---
/* Set de iconografía UI reutilizable (stroke = currentColor). */
interface Props { name: string; size?: number; }
const { name, size = 24 } = Astro.props;
const c = { width: size, height: size, viewBox: '0 0 24 24', fill: 'none', 'aria-hidden': 'true' as const };
---
{name === 'check' && <svg {...c}><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
{name === 'check-circle' && <svg {...c}><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M8.5 12.5l2.5 2.5 4.5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>}
{name === 'shield' && <svg {...c}><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>}
{name === 'gear' && <svg {...c}><circle cx="12" cy="12" r="3.2" stroke="currentColor" stroke-width="1.6"/><path d="M12 2v3m0 14v3m10-10h-3M5 12H2m15.5-6.5l-2 2m-7 7l-2 2m11 0l-2-2m-7-7l-2-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>}
{name === 'chart' && <svg {...c}><path d="M4 20V4m0 16h16M8 16v-4m4 4V8m4 8v-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>}
{name === 'layers' && <svg {...c}><path d="M12 3l9 5-9 5-9-5 9-5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M3 13l9 5 9-5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>}
{name === 'target' && <svg {...c}><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="1.4" fill="currentColor"/></svg>}
{name === 'clock' && <svg {...c}><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>}
{name === 'document' && <svg {...c}><path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8l-5-5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 3v5h5M9 13h6M9 17h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>}
{name === 'user' && <svg {...c}><circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.6"/><path d="M5 20c0-3.3 3.1-6 7-6s7 2.7 7 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>}
{name === 'spark' && <svg {...c}><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>}
{name === 'cube' && <svg {...c}><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M3.3 7L12 12l8.7-5M12 22V12" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>}
{name === 'wrench' && <svg {...c}><path d="M14.7 6.3a4 4 0 00-5.4 5.2l-5.6 5.6a1.5 1.5 0 002.1 2.1l5.6-5.6a4 4 0 005.2-5.4l-2.5 2.5-2.1-.4-.4-2.1 2.5-2.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>}
{name === 'download' && <svg {...c}><path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>}
{name === 'clipboard-check' && <svg {...c}><rect x="6" y="4" width="12" height="17" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M9 4a1 1 0 011-1h4a1 1 0 011 1v1.5H9V4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8.75 13l2 2 4-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>}
{name === 'scale' && <svg {...c}><path d="M12 4v16M8 20h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M6 7l6-1.4L18 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M6 7l-2.5 5.2a2.6 2.6 0 005 0L6 7zM18 7l-2.5 5.2a2.6 2.6 0 005 0L18 7z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>}
{name === 'equality' && <svg {...c}><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M8.5 10h7M8.5 14h7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>}
{name === 'hand' && <svg {...c}><path d="M8.5 11V6.2a1.4 1.4 0 012.8 0V10m0 0V4.8a1.4 1.4 0 012.8 0V10m0 0V6.2a1.4 1.4 0 012.8 0V13a6 6 0 01-6 6h-.6a6 6 0 01-5.1-2.9l-1.7-2.8a1.4 1.4 0 012.4-1.4L8.5 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>}
{name === 'globe' && <svg {...c}><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M3 12h18" stroke="currentColor" stroke-width="1.6"/><path d="M12 3c2.6 2.7 2.6 15.3 0 18M12 3c-2.6 2.7-2.6 15.3 0 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>}
{name === 'people' && <svg {...c}><circle cx="9" cy="9" r="3" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 19c0-3 2.5-5.2 5.5-5.2s5.5 2.2 5.5 5.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="17.2" cy="8" r="2.3" stroke="currentColor" stroke-width="1.6"/><path d="M16 13.4c2.7-.2 4.6 1.8 4.6 4.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>}
{name === 'heart' && <svg {...c}><path d="M12 20s-7-4.3-9.2-8.4C1.4 8.9 3.1 5.6 6 5.6c1.8 0 3 1 4 2.3 1-1.3 2.2-2.3 4-2.3 2.9 0 4.6 3.3 3.2 6C19 15.7 12 20 12 20z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>}
{name === 'no-drink' && <svg {...c}><path d="M8 5h8l-1 6.5a3 3 0 01-6 0L8 5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M12 17.5V20M9.5 20h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M4.5 4.5l15 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>}
{name === 'leaf' && <svg {...c}><path d="M5 19c-1-8 4.5-14 15-14 .5 9-5 15-13 15a5 5 0 01-2-.4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 16c1.8-3.5 4.8-6 8.5-7.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>}
{name === 'child' && <svg {...c}><circle cx="12" cy="5.5" r="2.5" stroke="currentColor" stroke-width="1.6"/><path d="M12 8.5v6M8.5 11.5h7M9.5 20l2.5-4 2.5 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>}
