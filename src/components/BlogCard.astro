---
import ImagePlaceholder from './ImagePlaceholder.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  /** 'featured' = post grande, 'side' = post mediano lateral, 'grid' = tarjeta de grilla */
  variant?: 'featured' | 'side' | 'grid';
}
const { post, variant = 'grid' } = Astro.props;
const { title, description, pubDate, category, author, cover, coverAlt } = post.data;
const date = pubDate.toLocaleDateString('es-PE', { day: 'numeric', month: 'short', year: 'numeric' });

const badgeByCategory: Record<string, string> = {
  Confiabilidad: 'badge--celeste',
  Integridad: 'badge--morado',
  'Transformación Digital': 'badge--azul',
};
const badgeClass = badgeByCategory[category] ?? 'badge--neutro';
const imgRatio = variant === 'side' ? '8/5' : '12/5';
---
<article class:list={['blog-card', `blog-card--${variant}`]} data-reveal>
  <a href={`/blog/${post.id}`} class="blog-card__link">
    <div class="blog-card__media">
      {cover ? (
        <img src={cover} alt={coverAlt || title} loading="lazy" />
      ) : (
        <ImagePlaceholder label={coverAlt || 'Portada del artículo'} ratio={imgRatio} tone="dark" />
      )}
    </div>
    <div class="blog-card__body">
      <p class="blog-card__meta">{author} • {date}</p>
      <div class="blog-card__heading-row">
        <h3 class="blog-card__title">{title}</h3>
        <span class="blog-card__arrow" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H8M17 7V16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </div>
      <p class="blog-card__desc">{description}</p>
      <div class="blog-card__tags">
        <span class:list={['badge', badgeClass]}>{category}</span>
      </div>
    </div>
  </a>
</article>

<style>
  .blog-card__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
    height: 100%;
    color: inherit;
  }
  .blog-card__media { width: 100%; }
  :global(.blog-card__media .ph) { border-radius: var(--radius-lg); }
  .blog-card__media img {
    width: 100%;
    border-radius: var(--radius-lg);
    object-fit: cover;
  }
  .blog-card--featured .blog-card__media img,
  .blog-card--grid .blog-card__media img { aspect-ratio: 12/5; }
  .blog-card--side .blog-card__media img { aspect-ratio: 8/5; }

  .blog-card__body { display: flex; flex-direction: column; gap: var(--space-4); flex: 1; }
  .blog-card__meta {
    font-size: var(--fs-text-s);
    font-weight: var(--fw-semibold);
    color: var(--accent);
  }
  .blog-card__heading-row { display: flex; align-items: flex-start; gap: var(--space-5); }
  .blog-card__title {
    flex: 1;
    font-family: var(--font-heading);
    font-weight: var(--fw-bold);
    color: var(--text-strong);
    line-height: var(--lh-tight);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .blog-card--featured .blog-card__title,
  .blog-card--grid .blog-card__title { font-size: var(--fs-h-s); }
  .blog-card--side .blog-card__title { font-size: var(--fs-h-xs); }
  .blog-card__arrow {
    display: flex;
    flex-shrink: 0;
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }
  .blog-card__link:hover .blog-card__title { color: var(--accent); }
  .blog-card__link:hover .blog-card__arrow { color: var(--accent); transform: translate(2px, -2px); }

  .blog-card__desc { color: var(--text-muted); }
  .blog-card--featured .blog-card__desc,
  .blog-card--grid .blog-card__desc { font-size: var(--fs-text-m); }
  .blog-card--side .blog-card__desc {
    font-size: var(--fs-text-m);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ---- Badges de categoría ---- */
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 2px var(--space-4);
    border-radius: var(--radius-pill);
    font-size: var(--fs-text-s);
    font-weight: var(--fw-medium);
  }
  .badge--celeste { background: var(--celeste-50); color: var(--celeste-700); }
  .badge--morado { background: var(--morado-50); color: var(--morado-600); }
  .badge--azul { background: var(--azul-50); color: var(--azul-600); }
  .badge--neutro { background: var(--neutro-100); color: var(--text-muted); }

  /* ---- Layout: tarjeta lateral (imagen + contenido en fila) ---- */
  .blog-card--side .blog-card__link { flex-direction: row; gap: var(--space-7); }
  .blog-card--side .blog-card__media { width: 320px; flex-shrink: 0; }
  .blog-card--side .blog-card__media img { height: 100%; }
  :global(.blog-card--side .blog-card__media .ph) { height: 100%; }

  @media (max-width: 900px) {
    .blog-card--side .blog-card__link { flex-direction: column; }
    .blog-card--side .blog-card__media { width: 100%; }
    .blog-card--side .blog-card__media img { aspect-ratio: 12/5; height: auto; }
  }
</style>
