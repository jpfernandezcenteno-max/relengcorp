---
/* ============================================================
   PARTICLES FIELD — fondo de partículas sutil (canvas + GSAP).
   Reutilizable: se ajusta al tamaño del ancestro indicado por `selector`.
   Respeta prefers-reduced-motion (no se renderiza nada).
   ============================================================ */
interface Props {
  /** Selector CSS del contenedor al que se ajusta el canvas (debe tener position: relative). */
  selector: string;
  /** Color de las partículas en formato "r, g, b". */
  color?: string;
  /** Cantidad de partículas. */
  count?: number;
  /** Opacidad general del canvas (controla qué tan sutil se ve). */
  opacity?: number;
}
const { selector, color = '0, 172, 229', count = 36, opacity = 0.8 } = Astro.props;
---

<canvas
  class="particles-field"
  aria-hidden="true"
  data-particles
  data-selector={selector}
  data-color={color}
  data-count={count}
  style={`opacity: ${opacity}`}
></canvas>

<style>
  .particles-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLCanvasElement>('canvas[data-particles]').forEach((canvas) => {
    const ctx = canvas.getContext('2d');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const host = canvas.closest(canvas.dataset.selector || '') as HTMLElement | null;
    const color = canvas.dataset.color || '0, 172, 229';
    const count = Number(canvas.dataset.count || 36);

    if (!host || !ctx || reduceMotion) return;

    import('gsap').then(({ default: gsap }) => {
      let width = 0;
      let height = 0;

      type Particle = { x: number; y: number; r: number; alpha: number };
      const particles: Particle[] = [];

      const resize = () => {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = host.offsetWidth;
        height = host.offsetHeight;
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };
      resize();

      for (let i = 0; i < count; i++) {
        const p: Particle = {
          x: Math.random() * width,
          y: Math.random() * height,
          r: Math.random() * 2 + 0.8,
          alpha: Math.random() * 0.5 + 0.35,
        };
        particles.push(p);

        // Deriva aleatoria
        gsap.to(p, {
          x: `+=${(Math.random() - 0.5) * 200}`,
          y: `+=${(Math.random() - 0.5) * 200}`,
          duration: 8 + Math.random() * 10,
          repeat: -1,
          yoyo: true,
          ease: 'sine.inOut',
        });
      }

      const LINK_DIST = 140;

      const draw = () => {
        ctx.clearRect(0, 0, width, height);

        // Líneas entre partículas cercanas
        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            const a = particles[i];
            const b = particles[j];
            const dx = a.x - b.x;
            const dy = a.y - b.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < LINK_DIST) {
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(b.x, b.y);
              ctx.strokeStyle = `rgba(${color}, ${(1 - dist / LINK_DIST) * 0.3})`;
              ctx.lineWidth = 1;
              ctx.stroke();
            }
          }
        }

        for (const p of particles) {
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${color}, ${p.alpha})`;
          ctx.fill();
        }
      };

      gsap.ticker.add(draw);

      let resizeTimer: ReturnType<typeof setTimeout>;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(resize, 200);
      });
    });
  });
</script>
