---
/* ============================================================
   HEADER — navegación principal.
   - Transparente sobre el hero, sólido al hacer scroll (premium).
   - Dropdown accesible de Servicios.
   - Menú móvil tipo drawer.
   ============================================================ */
import { nav, site } from '../data/site';
import logoSvg from '../../public/logo.svg?raw';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
const isHome = path === '/';
---

<header class:list={['site-header', { 'site-header--has-light-bg': !isHome }]} data-header>
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label={`${site.name} — inicio`}>
      <Fragment set:html={logoSvg} />
    </a>

    <nav class="site-nav" aria-label="Navegación principal">
      <ul class="site-nav__list">
        {
          nav.map((item) =>
            item.children ? (
              <li class="site-nav__item has-dropdown">
                <button
                  type="button"
                  class:list={['site-nav__link', 'site-nav__toggle', { 'is-active': isActive(item.href) }]}
                  aria-expanded="false"
                  aria-haspopup="true"
                >
                  {item.label}
                  <svg class="chev" width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <div class="dropdown" role="menu">
                  <ul>
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href} role="menuitem" class:list={['dropdown__link', { 'is-active': isActive(c.href) }]}>
                          {c.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li class="site-nav__item">
                <a href={item.href} class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}>
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <a href="/contacto" class="btn site-header__cta" data-gtm-id="header-cta-contacto">Contáctanos</a>

    <button
      type="button"
      class="site-header__burger"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-burger
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Menú móvil -->
  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="Navegación móvil">
      <ul>
        {
          nav.map((item) =>
            item.children ? (
              <li class="mobile-menu__group">
                <button type="button" class="mobile-menu__acc" aria-expanded="false">
                  {item.label}
                  <svg class="chev" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <ul class="mobile-menu__sub">
                  {item.children.map((c) => (
                    <li><a href={c.href}>{c.label}</a></li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href} class="mobile-menu__link">{item.label}</a>
              </li>
            )
          )
        }
      </ul>
    </nav>
    <a href="/contacto" class="btn btn--lg mobile-menu__cta" data-gtm-id="mobile-menu-cta-contacto">Contáctanos</a>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - clamp(24px, 4vw, 64px));
    max-width: 1360px;
    z-index: var(--z-header);
    height: var(--header-h);
    display: flex;
    align-items: center;
    border-radius: 100px;
    isolation: isolate;

    /* Cristal: casi transparente — el efecto viene de los highlights y el blur */
    background: rgba(20, 22, 36, 0.12);
    backdrop-filter: blur(28px) saturate(200%) brightness(1.04);
    -webkit-backdrop-filter: blur(28px) saturate(200%) brightness(1.04);

    /* Borde cristalino */
    border: 1px solid rgba(255, 255, 255, 0.22);

    /* Capas de inset que simulan el grosor del cristal */
    box-shadow:
      /* Profundidad externa */
      0 8px 40px rgba(0, 0, 0, 0.22),
      0 2px 8px rgba(0, 0, 0, 0.1),
      /* Especular superior — la luz que "rebota" en el borde de arriba */
      inset 0 1.5px 0 rgba(255, 255, 255, 0.52),
      /* Borde inferior interno */
      inset 0 -1px 0 rgba(255, 255, 255, 0.1),
      /* Borde lateral izquierdo */
      inset 1.5px 0 0 rgba(255, 255, 255, 0.18),
      /* Borde lateral derecho */
      inset -1px 0 0 rgba(255, 255, 255, 0.08);

    transition:
      background var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  /* Reflejo interno diagonal (simula la refracción de luz en el cristal) */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      130deg,
      rgba(255, 255, 255, 0.18) 0%,
      rgba(255, 255, 255, 0.05) 30%,
      transparent 60%
    );
    pointer-events: none;
    z-index: 0;
  }

  /* Efecto iridiscente / prismático en el borde inferior */
  .site-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 8%;
    right: 8%;
    height: 1.5px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      hsla(30, 90%, 72%, 0.6) 18%,
      hsla(195, 85%, 68%, 0.6) 42%,
      hsla(265, 75%, 72%, 0.5) 68%,
      transparent 100%
    );
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  /* Scrolled: un poco más opaco para legibilidad al desplazarse */
  .site-header.is-scrolled {
    background: rgba(20, 22, 36, 0.52);
    border-color: rgba(255, 255, 255, 0.18);
    box-shadow:
      0 16px 48px rgba(0, 0, 0, 0.35),
      0 4px 12px rgba(0, 0, 0, 0.15),
      inset 0 1.5px 0 rgba(255, 255, 255, 0.42),
      inset 0 -1px 0 rgba(255, 255, 255, 0.1),
      inset 1.5px 0 0 rgba(255, 255, 255, 0.14),
      inset -1px 0 0 rgba(255, 255, 255, 0.06);
  }

  /* Páginas internas (fondo claro): cristal blanco */
  .site-header--has-light-bg:not(.is-scrolled) {
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(28px) saturate(200%) brightness(1.02);
    -webkit-backdrop-filter: blur(28px) saturate(200%) brightness(1.02);
    border-color: rgba(255, 255, 255, 0.5);
    box-shadow:
      0 8px 40px rgba(0, 0, 0, 0.1),
      0 2px 8px rgba(0, 0, 0, 0.05),
      inset 0 1.5px 0 rgba(255, 255, 255, 0.85),
      inset 0 -1px 0 rgba(255, 255, 255, 0.35),
      inset 1.5px 0 0 rgba(255, 255, 255, 0.45),
      inset -1px 0 0 rgba(255, 255, 255, 0.2);
  }

  /* Menú móvil abierto: quitar backdrop-filter (Chromium containing-block bug) */
  .site-header.menu-open {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-radius: 100px 100px 0 0;
    border-bottom-color: transparent;
  }
  .site-header.menu-open::after { display: none; }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .site-header__logo {
    color: #fff;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .site-header__logo :global(svg) { display: block; height: 34px; width: auto; aspect-ratio: 1322.44 / 305.4; }

  /* Páginas internas: el header arranca sobre un fondo claro, así que
     el logo y los enlaces necesitan tono oscuro hasta hacer scroll. */
  .site-header--has-light-bg:not(.is-scrolled) .site-header__logo { color: var(--accent); }
  .site-header--has-light-bg:not(.is-scrolled) .site-nav__link { color: var(--text-body); }
  .site-header--has-light-bg:not(.is-scrolled) .site-nav__link:hover,
  .site-header--has-light-bg:not(.is-scrolled) .site-nav__link.is-active { color: var(--text-strong); }
  .site-header--has-light-bg:not(.is-scrolled) .site-header__burger span { background: var(--text-strong); }

  .site-nav { margin-inline: auto; }
  .site-nav__list { display: flex; align-items: center; gap: var(--space-2); }
  .site-nav__item { position: relative; }

  .site-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    font-size: var(--fs-text-s);
    font-weight: var(--fw-semibold);
    color: rgba(255, 255, 255, 0.88);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }
  .site-nav__link::after {
    content: '';
    position: absolute;
    left: var(--space-4);
    right: var(--space-4);
    bottom: 6px;
    height: 1px;
    border-radius: var(--radius-pill);
    background: currentColor;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .site-nav__link:hover,
  .site-nav__link.is-active { color: #fff; }
  .site-nav__link:hover::after,
  .site-nav__link.is-active::after { transform: scaleX(1); }
  .site-nav__toggle .chev { transition: transform var(--dur-fast) var(--ease-out); }

  /* Dropdown */
  .dropdown {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translate(-50%, 8px);
    min-width: 300px;
    background: var(--neutro-0);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-5);
    padding: var(--space-3);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out), visibility var(--dur-fast);
  }
  .dropdown::before {
    /* puente invisible para no perder el hover */
    content: '';
    position: absolute;
    inset: -12px 0 auto 0;
    height: 12px;
  }
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }
  .has-dropdown:hover .chev,
  .has-dropdown:focus-within .chev { transform: rotate(180deg); }

  .dropdown__link {
    display: block;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    font-size: var(--fs-text-s);
    font-weight: var(--fw-medium);
    color: var(--text-body);
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .dropdown__link:hover,
  .dropdown__link.is-active { background: var(--accent-soft); color: var(--accent-hover); }

  .site-header__cta { flex-shrink: 0; padding: 0.6rem 1.25rem; min-height: 42px; font-size: var(--fs-text-s); }

  /* Burger */
  .site-header__burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: var(--space-3);
    margin-left: auto;
  }
  .site-header__burger span {
    width: 24px; height: 2px;
    background: #fff;
    border-radius: 2px;
    transform-origin: center;
    transition: transform var(--dur-base) var(--ease-in-out);
  }
  /* La barra central se contrae primero al abrir y reaparece al final al cerrar */
  .site-header__burger span:nth-child(2) {
    transition: transform var(--dur-fast) var(--ease-in-out), opacity var(--dur-fast) var(--ease-in-out);
  }
  .site-header:not(.menu-open) .site-header__burger span:nth-child(2) {
    transition-delay: 120ms;
  }
  /* Las barras externas rotan con un pequeño retraso al abrir, para que el morph se vea encadenado */
  .site-header.menu-open .site-header__burger span:nth-child(1),
  .site-header.menu-open .site-header__burger span:nth-child(3) {
    transition-delay: 80ms;
  }
  .site-header.menu-open .site-header__burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .site-header.menu-open .site-header__burger span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .site-header.menu-open .site-header__burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Menú móvil — se alinea con el header flotante */
  .mobile-menu {
    position: fixed;
    top: calc(12px + var(--header-h));
    left: 50%;
    transform: translateX(-50%) translateX(100vw);
    width: calc(100% - clamp(24px, 4vw, 64px));
    max-width: 1360px;
    bottom: 0;
    background: var(--bg-dark);
    border-radius: 0 0 100px 100px;
    border: 0.5px solid rgba(255, 255, 255, 0.12);
    border-top: none;
    padding: var(--space-7) var(--container-pad) var(--space-9);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .site-header.menu-open .mobile-menu {
    transform: translateX(-50%) translateX(0);
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu a, .mobile-menu button { color: #fff; }
  .mobile-menu > nav > ul { display: flex; flex-direction: column; }
  .mobile-menu__link, .mobile-menu__acc {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: var(--space-5) 0;
    font-size: var(--fs-text-l);
    font-weight: var(--fw-normal);
    border-bottom: 1px solid var(--border-dark);
  }
  .mobile-menu__sub {
    max-height: 0;
    overflow: hidden;
    transition: max-height var(--dur-base) var(--ease-out);
  }
  .mobile-menu__group.open .mobile-menu__sub { max-height: 600px; }
  .mobile-menu__group.open .mobile-menu__acc .chev { transform: rotate(180deg); }
  .mobile-menu__acc .chev { transition: transform var(--dur-fast) var(--ease-out); }
  .mobile-menu__sub li a {
    display: block;
    padding: var(--space-4) 0 var(--space-4) var(--space-5);
    font-size: var(--fs-text-m);
    color: var(--azul-100);
    border-bottom: 1px solid var(--border-dark);
  }
  .mobile-menu__cta { margin-top: var(--space-4); }

  /* Breakpoint: tablet/mobile */
  @media (max-width: 980px) {
    .site-nav, .site-header__cta { display: none; }
    .site-header__burger { display: flex; }
    .site-header__logo { margin-right: auto; }
  }
</style>

<script>
  // ---- Estado "scrolled" del header (IntersectionObserver = sin jank en scroll) ----
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    // Sentinel al inicio del documento; cuando sale del viewport -> scrolled.
    const sentinel = document.createElement('div');
    sentinel.style.cssText = 'position:absolute;top:0;height:8px;width:1px;pointer-events:none;';
    document.body.prepend(sentinel);
    const io = new IntersectionObserver(
      ([entry]) => header.classList.toggle('is-scrolled', !entry.isIntersecting),
      { rootMargin: '0px' }
    );
    io.observe(sentinel);

    // ---- Menú móvil ----
    const burger = header.querySelector<HTMLButtonElement>('[data-burger]');
    const menu = header.querySelector<HTMLElement>('[data-mobile-menu]');
    burger?.addEventListener('click', () => {
      if (menu?.hidden) {
        // primera apertura: quitamos "hidden" y forzamos reflow antes de
        // animar, para que el navegador registre el estado de partida
        // (translateX(100%)) y la transición se reproduzca correctamente
        menu.hidden = false;
        menu.getBoundingClientRect();
      }
      const open = header.classList.toggle('menu-open');
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      document.body.style.overflow = open ? 'hidden' : '';
    });

    // Acordeones del menú móvil
    header.querySelectorAll<HTMLButtonElement>('.mobile-menu__acc').forEach((acc) => {
      acc.addEventListener('click', () => {
        const group = acc.closest('.mobile-menu__group');
        const open = group?.classList.toggle('open');
        acc.setAttribute('aria-expanded', String(!!open));
      });
    });

    // Cerrar menú al navegar
    menu?.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        header.classList.remove('menu-open');
        document.body.style.overflow = '';
      })
    );
  }
</script>
