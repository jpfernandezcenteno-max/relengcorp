---
/* ============================================================
   CONTACT FORM — formulario reutilizable con validación.
   variant:
     - 'contact' : Nombre, Email, Teléfono, Empresa, País, Mensaje
     - 'service' : captación de lead (+ descarga de brochure al enviar)
     - 'job'     : postulación (Nombre, Email, Teléfono, Mensaje, CV)
   NOTA backend: el envío real se conecta cuando se defina hosting/correo.
   Por ahora valida en frontend y confirma (y descarga brochure en 'service').
   ============================================================ */
interface Subservice { name: string; slogan?: string }
interface Props {
  variant?: 'contact' | 'service' | 'job';
  title?: string;
  description?: string;
  submitLabel?: string;
  serviceName?: string;
  brochureUrl?: string; // PDF a descargar (placeholder hasta que el cliente lo suba)
  compact?: boolean;
  subservices?: Subservice[]; // sub-servicios del servicio (dropdown en variant 'service')
  serviceSlug?: string;       // para construir la ruta de la ficha técnica de cada sub-servicio
}
const {
  variant = 'contact',
  title,
  description,
  submitLabel = 'Enviar solicitud',
  serviceName,
  brochureUrl = '/brochures/brochure-relengcorp.pdf',
  compact = false,
  subservices = [],
  serviceSlug,
} = Astro.props;
const showMessage = variant === 'contact' || variant === 'job';
const showCompany = variant === 'contact' || variant === 'service';
const showCV = variant === 'job';

// Dropdown de sub-servicios (solo variant 'service'). Cada opción apunta a su ficha técnica.
// Las fichas se suben a /public/fichas/<slug-servicio>/<slug-subservicio>.pdf
const slugify = (s: string) =>
  s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const showSubservices = variant === 'service' && subservices.length > 0;
const subOptions = showSubservices
  ? subservices.map((s) => ({ name: s.name, ficha: `/fichas/${serviceSlug ?? 'general'}/${slugify(s.name)}.pdf` }))
  : [];
---
<form
  class:list={['cform', { 'cform--compact': compact }]}
  data-form
  data-variant={variant}
  data-brochure={variant === 'service' ? brochureUrl : undefined}
  novalidate
>
  {title && <h3 class="cform__title h-s" data-reveal>{title}</h3>}
  {description && <p class="cform__desc text-s" data-reveal>{description}</p>}
  {serviceName && <input type="hidden" name="servicio" value={serviceName} />}
  <input type="hidden" name="variant" value={variant} />
  {/* Honeypot anti-spam: invisible para humanos; si un bot lo llena, se descarta */}
  <input type="text" name="website" class="cform__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <p class="cform__error-general" data-form-error hidden role="alert"></p>

  <div class="cform__grid">
    {showSubservices && (
      <div class="field field--full">
        <label for="cf-subservice">Sub-servicio de interés *</label>
        <select id="cf-subservice" name="subservicio" required data-ficha-select>
          <option value="" disabled selected>Selecciona un sub-servicio…</option>
          {subOptions.map((o) => (
            <option value={o.name} data-ficha={o.ficha}>{o.name}</option>
          ))}
        </select>
        <p class="field__error" data-error></p>
        <p class="cform__ficha-hint text-xs">Al enviar recibirás la ficha técnica del sub-servicio seleccionado.</p>
      </div>
    )}

    <div class="field">
      <label for="cf-name">Nombre completo *</label>
      <input type="text" id="cf-name" name="nombre" required autocomplete="name" />
      <p class="field__error" data-error></p>
    </div>

    <div class="field">
      <label for="cf-email">Correo electrónico *</label>
      <input type="email" id="cf-email" name="email" required autocomplete="email" />
      <p class="field__error" data-error></p>
    </div>

    <div class:list={['field', { 'field--full': !showCompany }]}>
      <label for="cf-phone">Teléfono *</label>
      <input type="tel" id="cf-phone" name="telefono" required autocomplete="tel" inputmode="tel" />
      <p class="field__error" data-error></p>
    </div>

    {showCompany && (
      <div class="field">
        <label for="cf-company">Empresa</label>
        <input type="text" id="cf-company" name="empresa" autocomplete="organization" />
        <p class="field__error" data-error></p>
      </div>
    )}

    {variant === 'contact' && (
      <div class="field">
        <label for="cf-country">País</label>
        <input type="text" id="cf-country" name="pais" autocomplete="country-name" />
        <p class="field__error" data-error></p>
      </div>
    )}

    {variant === 'contact' && (
      <div class="field">
        <label for="cf-solution-interest">Solución de interés</label>
        <select id="cf-solution-interest" name="solucion_interes">
          <option value="" selected></option>
          <option value="Integridad Estructural">Integridad Estructural</option>
          <option value="Monitoreo y Mantenimiento Predictivo">Monitoreo y Mantenimiento Predictivo</option>
          <option value="Ingeniería de Confiabilidad">Ingeniería de Confiabilidad</option>
          <option value="Metalurgia Inteligente">Metalurgia Inteligente</option>
          <option value="Confiabilidad Inteligente">Confiabilidad Inteligente</option>
          <option value="Ingeniería Digital">Ingeniería Digital</option>
          <option value="Gestión de Reparables Críticos">Gestión de Reparables Críticos</option>
          <option value="No estoy seguro / Otro desafío">No estoy seguro / Otro desafío</option>
        </select>
        <p class="field__error" data-error></p>
      </div>
    )}

    {variant === 'job' && (
      <div class="field">
        <label for="cf-area-interest">Área/Solución de interés</label>
        <input type="text" id="cf-area-interest" name="area_interes" />
        <p class="field__error" data-error></p>
      </div>
      <div class="field">
        <label for="cf-city-country">Ciudad/País</label>
        <input type="text" id="cf-city-country" name="ciudad_pais" />
        <p class="field__error" data-error></p>
      </div>
    )}

    {showMessage && (
      <div class="field field--full">
        <label for="cf-message">{variant === 'job' ? 'Mensaje o descripción' : 'Mensaje'} *</label>
        <textarea id="cf-message" name="mensaje" rows="4" required></textarea>
        <p class="field__error" data-error></p>
      </div>
    )}

    {showCV && (
      <div class="field field--full">
        <label for="cf-cv">Sube tu CV (PDF) *</label>
        <input type="file" id="cf-cv" name="cv" accept=".pdf,.doc,.docx" required />
        <p class="field__error" data-error></p>
      </div>
    )}
  </div>

  <div class="cform__consent-wrap">
    <label class="cform__consent">
      <input type="checkbox" id="cf-consent" name="acepta_politica" required data-consent />
      <span>
        Acepto la
        <a href="/politica-de-privacidad" target="_blank" rel="noopener" class="cform__policy-link">Política de Protección de Datos Personales</a>
        y autorizo a RELENG SOLUTION SAC al tratamiento de mis datos para recibir información sobre sus servicios.
      </span>
    </label>
    <p class="field__error" data-consent-error></p>
  </div>

  <div class="cform__actions">
    <button type="submit" class="btn btn--lg" data-gtm-id={`form-submit-${variant}`}>{submitLabel}</button>
    <p class="cform__note text-xs">Campos obligatorios marcados con *. Tus datos se tratan de forma confidencial.</p>
  </div>

  <p class="cform__success" data-success hidden role="status" data-success-text></p>
</form>

<style>
  .cform {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .cform--compact { padding: var(--space-6); box-shadow: none; gap: var(--space-4); }
  .cform--compact .cform__title { font-size: var(--fs-h-xs); }
  .cform--compact .cform__desc { font-size: var(--fs-text-xs); }
  .cform--compact .cform__grid { gap: var(--space-4); }
  .cform--compact .field { gap: var(--space-2); }
  .cform--compact .field label { font-size: var(--fs-text-xs); }
  .cform--compact .field input,
  .cform--compact .field textarea { padding: 0.55rem 0.85rem; font-size: var(--fs-text-s); border-radius: var(--radius-sm); }
  .cform--compact .field textarea { min-height: 84px; }
  .cform--compact .btn { padding: 0.6rem 1.25rem; min-height: 42px; font-size: var(--fs-text-s); }
  .cform--compact .cform__note { font-size: 0.7rem; }
  .cform__title { color: var(--text-strong); }
  .cform__desc { color: var(--text-body); }

  .cform__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); }
  .field { display: flex; flex-direction: column; gap: var(--space-3); }
  .field--full { grid-column: 1 / -1; }
  .field label { font-size: var(--fs-text-s); font-weight: var(--fw-semibold); color: var(--text-strong); }
  .field input,
  .field textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--neutro-50);
    transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  .field textarea { resize: vertical; min-height: 110px; }
  .field input:focus,
  .field textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 4px rgba(0,172,229,0.15); }
  .field input[aria-invalid='true'],
  .field textarea[aria-invalid='true'] { border-color: #e5484d; }
  .field input[type='file'] { padding: 0.6rem; background: var(--neutro-100); cursor: pointer; }
  .field__error { color: #e5484d; font-size: var(--fs-text-xs); min-height: 1em; }

  .field select {
    width: 100%;
    padding: 0.75rem 2.5rem 0.75rem 1rem;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--neutro-50);
    color: var(--text-strong);
    font: inherit;
    cursor: pointer;
    appearance: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%2364748b' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M6 9l6 6 6-6'/></svg>");
    background-repeat: no-repeat;
    background-position: right 1rem center;
    transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  .field select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 4px rgba(0,172,229,0.15); }
  .field select[aria-invalid='true'] { border-color: #e5484d; }
  .cform__ficha-hint { color: var(--text-muted); }

  .cform__consent {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--fs-text-s);
    color: var(--text-body);
    cursor: pointer;
  }
  .cform__consent input { width: 18px; height: 18px; flex-shrink: 0; margin-top: 2px; accent-color: var(--accent); cursor: pointer; }
  .cform__policy-link { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; font-weight: var(--fw-medium); }
  .cform__policy-link:hover { color: var(--accent-hover); }
  .cform__consent input[aria-invalid='true'] { outline: 2px solid #e5484d; outline-offset: 2px; }

  .cform__actions { display: flex; flex-direction: column; gap: var(--space-3); align-items: flex-start; }
  .cform__note { color: var(--text-muted); }

  .cform__success {
    color: var(--success);
    font-weight: var(--fw-semibold);
  }
  .cform__hp { position: absolute !important; left: -9999px; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .cform__error-general { color: #e5484d; font-weight: var(--fw-medium); font-size: var(--fs-text-s); }
  .cform__error-general[hidden] { display: none; }

  .cform__grid[hidden],
  .cform__consent-wrap[hidden],
  .cform__actions[hidden] { display: none; }

  @media (max-width: 560px) {
    .cform { padding: var(--space-6); }
    .cform__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-form]').forEach((form) => {
    // Se excluye el honeypot (name="website") de la validación visible.
    const fields = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
      'input:not([type="checkbox"]):not([name="website"]), textarea, select',
    );
    const successBox = form.querySelector<HTMLElement>('[data-success]');
    const errorBox = form.querySelector<HTMLElement>('[data-form-error]');
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const variant = form.dataset.variant;
    const brochure = form.dataset.brochure;

    const setError = (field: HTMLElement, msg: string) => {
      field.setAttribute('aria-invalid', 'true');
      const err = field.parentElement?.querySelector<HTMLElement>('[data-error]');
      if (err) err.textContent = msg;
    };
    const clearError = (field: HTMLElement) => {
      field.removeAttribute('aria-invalid');
      const err = field.parentElement?.querySelector<HTMLElement>('[data-error]');
      if (err) err.textContent = '';
    };
    const download = (href: string) => {
      const a = document.createElement('a');
      a.href = href;
      a.download = '';
      document.body.appendChild(a);
      a.click();
      a.remove();
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      let valid = true;
      let firstInvalid: HTMLElement | null = null;

      fields.forEach((f) => {
        clearError(f);
        const value = f.value.trim();
        if (f.hasAttribute('required') && !value) {
          setError(f, 'Este campo es obligatorio.');
          valid = false;
          firstInvalid ||= f;
        } else if (f.type === 'email' && value && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
          setError(f, 'Ingresa un correo válido.');
          valid = false;
          firstInvalid ||= f;
        } else if (f.type === 'tel' && value && value.replace(/\D/g, '').length < 7) {
          setError(f, 'Ingresa un teléfono válido.');
          valid = false;
          firstInvalid ||= f;
        }
      });

      // Validar el consentimiento de la política (obligatorio)
      const consent = form.querySelector<HTMLInputElement>('[data-consent]');
      const consentError = form.querySelector<HTMLElement>('[data-consent-error]');
      if (consent && !consent.checked) {
        consent.setAttribute('aria-invalid', 'true');
        if (consentError) consentError.textContent = 'Debes aceptar la Política de Protección de Datos Personales.';
        valid = false;
        firstInvalid ||= consent;
      } else if (consent) {
        consent.removeAttribute('aria-invalid');
        if (consentError) consentError.textContent = '';
      }

      if (!valid) { firstInvalid?.focus(); return; }

      // Envío real al backend PHP.
      if (errorBox) errorBox.hidden = true;
      const label = submitBtn?.textContent ?? 'Enviar';
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Enviando…'; }

      try {
        const res = await fetch('/enviar.php', { method: 'POST', body: new FormData(form) });
        let json: { ok?: boolean; error?: string } = {};
        try { json = await res.json(); } catch { /* respuesta no-JSON */ }
        if (!res.ok || !json.ok) throw new Error(json.error || 'No se pudo enviar el mensaje.');

        // Éxito. Variante 'service': descargar la ficha del sub-servicio (o brochure).
        if (variant === 'service') {
          const sel = form.querySelector<HTMLSelectElement>('[data-ficha-select]');
          const ficha = sel?.selectedOptions[0]?.dataset.ficha || brochure;
          if (ficha) download(ficha);
        }

        const msg =
          variant === 'service'
            ? '¡Gracias! La ficha técnica se está descargando y un especialista te contactará pronto.'
            : variant === 'job'
              ? '¡Gracias por postular! Revisaremos tu información y te contactaremos.'
              : '¡Gracias! Hemos recibido tu mensaje. Te contactaremos muy pronto.';

        form.querySelectorAll('.cform__grid, .cform__consent-wrap, .cform__actions').forEach((el) => el.setAttribute('hidden', ''));
        if (successBox) {
          successBox.textContent = msg;
          successBox.hidden = false;
          successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      } catch (err) {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = label; }
        if (errorBox) {
          errorBox.textContent =
            (err instanceof Error ? err.message : 'No se pudo enviar el mensaje.') + ' Por favor, inténtalo de nuevo.';
          errorBox.hidden = false;
        }
      }
    });
  });
</script>
